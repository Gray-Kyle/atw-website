---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Book a call" description="Schedule time with ATW" canonical="https://atw.net/book">
  <section class="container max-w-2xl py-16">
    <a href="/contact" class="text-sm text-muted-foreground hover:text-primary">← Back to Contact</a>
    <h1 class="mt-6 text-3xl font-semibold">Book a call</h1>
    <p class="mt-2 text-muted-foreground">
      Schedule a 30-minute conversation about ATW One, implementation, or partner solutions.
    </p>
    <div id="atw-booking-root" class="mt-8"></div>
  </section>
  <script src="/js/booking-flow.js" defer></script>
</MarketingLayout>
