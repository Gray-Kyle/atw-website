---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogIndexClient from '../../components/blog/BlogIndexClient.astro';
import {
  BLOG_TOPICS,
  fetchIndexablePosts,
  toBlogCard,
} from '../../lib/blog';
import { blogJsonLd, breadcrumbListJsonLd } from '../../lib/seo';

const posts = (await fetchIndexablePosts(100)).map(toBlogCard);
const featured = posts.slice(0, 3);
const rest = posts.slice(3);

const description =
  'Guides and updates on ATW One, Orbit, Hub, Workforce, Directory, ATW AI, and business operations from the ATW.Net team.';

const jsonLd = [
  blogJsonLd({ description }),
  breadcrumbListJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]),
];
---

<MarketingLayout
  title="ATW.Net Blog | product guides and operations insights"
  description={description}
  canonical="https://atw.net/blog/"
  jsonLd={jsonLd}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="ATW.Net Blog RSS" href="/blog/rss.xml" />

  <section class="container py-12 sm:py-16" data-blog-index>
    <div class="max-w-3xl">
      <h1 class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">ATW.Net Blog</h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        Practical guides on ATW products and the work around them: ATW One, Orbit, Hub, Workforce, Directory, ATW AI,
        and day-to-day business operations. Written for operators, not jargon.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <div class="mt-10 max-w-xl space-y-4 text-muted-foreground">
          <p>No posts to show yet.</p>
          <p class="text-sm">
            In the meantime, see{' '}
            <a href="/docs/" class="text-primary underline">
              Docs
            </a>{' '}
            or{' '}
            <a href="/systems/" class="text-primary underline">
              Systems
            </a>
            .
          </p>
        </div>
      ) : (
        <>
          {featured.length > 0 ? (
            <div class="mt-10">
              <div class="mb-4 flex items-end justify-between gap-3">
                <h2 class="font-heading text-xl font-semibold text-foreground">Latest</h2>
                <p class="text-sm text-muted-foreground" data-blog-count>
                  {posts.length} posts
                </p>
              </div>
              <div class="grid gap-4 md:grid-cols-3">
                {featured.map((post) => (
                  <div
                    data-blog-featured-card
                    data-topics={post.topics.join(' ')}
                    data-title={post.title.toLowerCase()}
                    data-excerpt={(post.excerpt || '').toLowerCase()}
                    data-category={post.category.toLowerCase()}
                  >
                    <BlogCard post={post} featured listed={false} />
                  </div>
                ))}
              </div>
            </div>
          ) : null}

          <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by topic">
              {BLOG_TOPICS.map((topic, index) => (
                <button
                  type="button"
                  data-blog-topic={topic.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  class="rounded-full border border-border bg-transparent px-3 py-1.5 text-xs font-semibold text-foreground transition hover:bg-muted aria-pressed:border-transparent aria-pressed:bg-[#5b9bff] aria-pressed:text-[#06101c]"
                  style={index === 0 ? 'background:#5b9bff;color:#06101c;border-color:transparent' : undefined}
                >
                  {topic.label}
                </button>
              ))}
            </div>
            <label class="block w-full sm:max-w-xs">
              <span class="sr-only">Search posts</span>
              <input
                type="search"
                data-blog-search
                placeholder="Search posts"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5b9bff]"
              />
            </label>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-blog-grid>
            {(rest.length ? rest : posts).map((post) => (
              <BlogCard post={post} />
            ))}
          </div>

          <p class="mt-8 hidden text-sm text-muted-foreground" data-blog-empty>
            No posts match that filter. Try another topic or clear search.
          </p>

          <div class="mt-8 flex items-center justify-between gap-3" data-blog-pager hidden>
            <button
              type="button"
              data-blog-prev
              class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted disabled:opacity-40"
            >
              Previous
            </button>
            <p class="text-sm text-muted-foreground" data-blog-page-label>Page 1</p>
            <button
              type="button"
              data-blog-next
              class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted disabled:opacity-40"
            >
              Next
            </button>
          </div>

          <BlogIndexClient />
        </>
      )
    }
  </section>
</MarketingLayout>
