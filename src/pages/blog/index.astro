---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { fetchPublicPosts } from '../../lib/blog';

const posts = await fetchPublicPosts(50);
---

<MarketingLayout
  title="Blog"
  description="Updates on ERP, CRM, and implementation work from ATW Network."
  canonical="https://atw.net/blog"
>
  <section class="container py-16">
    <h1 class="text-3xl font-bold">Blog</h1>
    <p class="mt-2 text-muted-foreground">Updates on ERP, CRM, and implementation work.</p>
    {
      posts.length === 0 ? (
        <div class="mt-10 max-w-xl space-y-4 text-muted-foreground">
          <p>No posts to show yet.</p>
          <p class="text-sm">
            In the meantime, see{' '}
            <a href="/docs" class="text-primary underline">
              Docs
            </a>
            {' '}or{' '}
            <a href="/solutions" class="text-primary underline">
              Solutions
            </a>
            .
          </p>
        </div>
      ) : (
        <ul class="mt-10 space-y-6">
          {posts.map((post) => (
            <li class="rounded-xl border border-border p-6">
              <a href={`/blog/${post.slug}`} class="text-xl font-semibold text-brand-ink hover:text-primary">
                {post.title}
              </a>
              {post.excerpt ? <p class="mt-2 text-sm text-muted-foreground">{post.excerpt}</p> : null}
              {post.publishedAt ? (
                <p class="mt-2 text-xs text-muted-foreground">{new Date(post.publishedAt).toLocaleDateString('en-US')}</p>
              ) : null}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</MarketingLayout>
