---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LegalShell from '../components/marketing/LegalShell.astro';
---

<MarketingLayout title="Terms and Conditions" description="ATW Network terms" canonical="https://atw.net/terms">
  <LegalShell title="Terms and Conditions">
    <section class="rounded-xl border border-border p-6">
      <h2 class="text-2xl font-semibold">Agreement</h2>
      <p class="mt-4 text-muted-foreground">
        By creating an ATW account or using ATW Network products and services (including ATW One, ATW Mail, ATW Pay, and related apps), you agree to these Terms and Conditions on behalf of yourself and the organization you represent.
      </p>
    </section>
    <section class="rounded-xl border border-border p-6">
      <h2 class="text-2xl font-semibold">Accounts and organizations</h2>
      <p class="mt-4 text-muted-foreground">
        You must provide accurate registration information, keep credentials secure, and ensure you have authority to bind your organization. You are responsible for activity under your account and organization domain.
      </p>
    </section>
    <section class="rounded-xl border border-border p-6">
      <h2 class="text-2xl font-semibold">Acceptable use</h2>
      <p class="mt-4 text-muted-foreground">
        Do not misuse the services, attempt unauthorized access, interfere with other customers, or use ATW products for unlawful purposes. We may suspend or terminate access for abuse or risk to the platform.
      </p>
    </section>
    <section class="rounded-xl border border-border p-6">
      <h2 class="text-2xl font-semibold">Communications</h2>
      <p class="mt-4 text-muted-foreground">
        We may send service, security, and account messages by email. SMS for marketing and customer care requires a separate opt-in checkbox (see <a href="/sms-terms" class="text-primary underline">SMS Terms</a>). Message and data rates may apply. See our <a href="/privacy-policy" class="text-primary underline">Privacy Policy</a> for how we handle personal data.
      </p>
    </section>
    <section class="rounded-xl border border-border p-6">
      <h2 class="text-2xl font-semibold">Changes</h2>
      <p class="mt-4 text-muted-foreground">
        We may update these terms from time to time. Continued use after changes constitutes acceptance of the updated terms. Questions? <a href="/contact" class="text-primary underline">Contact us</a>.
      </p>
    </section>
  </LegalShell>
</MarketingLayout>
