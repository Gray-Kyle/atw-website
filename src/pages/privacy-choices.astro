---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LegalShell from '../components/marketing/LegalShell.astro';
---

<MarketingLayout title="Privacy choices" description="Your privacy choices at ATW" canonical="https://atw.net/privacy-choices">
  <LegalShell title="Privacy choices">
    <p class="text-muted-foreground">
      You may request access, correction, or deletion of personal data we hold about you by emailing <a href="mailto:support@atw.net" class="text-primary underline">support@atw.net</a>. Marketing email and SMS opt-outs are honored per message instructions and account settings where available.
    </p>
  </LegalShell>
</MarketingLayout>
