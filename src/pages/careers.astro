---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Careers" description="Careers at ATW" canonical="https://atw.net/careers">
  <section class="container max-w-3xl py-16">
    <h1 class="mb-4 text-3xl font-medium">Careers at ATW</h1>
    <p class="mb-6 text-dark-text">
      We are not listing open roles on this page yet. If you want to work on ATW One, Mail, Pay, or customer delivery, email{' '}
      <a href="mailto:admin@atw.net" class="text-primary underline">admin@atw.net</a> with a short note and a resume or LinkedIn profile.
    </p>
    <p class="text-sm text-muted-foreground">
      Looking for product help instead? <a href="/contact" class="text-primary underline">Contact support</a>.
    </p>
  </section>
</MarketingLayout>
