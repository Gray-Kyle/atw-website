---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SystemMarketingPage from '../components/marketing/SystemMarketingPage.astro';
import { PRODUCT } from '../lib/site';
import { faqPageJsonLd } from '../lib/seo';
import { PRODUCT_MARKS } from '../data/productMarks';

const faqs = [
  {
    q: 'What is ATW Hub?',
    a: 'Hub is an Outlook-like inbox and workspace client at hub.atw.net. It connects to ATW Orbit, Google Workspace, Microsoft Teams, and Outlook.',
  },
  {
    q: 'Is Hub a separate purchase?',
    a: 'No. Hub is included with every plan. It is not a customer-paid SKU.',
  },
  {
    q: 'How does Hub relate to Mail and Orbit?',
    a: 'Mail is an app inside ATW Orbit, not inside Hub. Hub is a separate client that can connect to ATW Orbit (and to Google Workspace, Microsoft Teams, and Outlook). Orbit mailboxes draw from the organization Credits pool.',
  },
] as const;
---

<MarketingLayout
  title="ATW Hub | inbox and workspace client"
  description="ATW Hub is an Outlook-like inbox and workspace client that connects to ATW Orbit, Google Workspace, Microsoft Teams, and Outlook. Included with every plan."
  canonical="https://atw.net/hub"
  jsonLd={faqPageJsonLd('/hub', faqs)}
>
  <SystemMarketingPage
    systemId="hub"
    headline="An Outlook-like client for your workspace"
    lead="Hub connects to ATW Orbit, Google Workspace, Microsoft Teams, and Outlook so you can work from one inbox and workspace client. It is included with every plan, not a separate purchase."
    primaryCta={{ label: 'Talk to us', href: '/contact' }}
    secondaryCta={{ label: 'Open Hub', href: PRODUCT.hub }}
    faqs={faqs}
    brandWordmark={PRODUCT_MARKS.hub.wordmark}
  />
</MarketingLayout>
