---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import { PRODUCT } from '../lib/site';
---

<MarketingLayout title="ATW Hub — team chat" description="Channels and direct messages for your organization." canonical="https://atw.net/hub">
  <PageHero
    title="Team chat for your organization"
    description="Channels and direct messages for the people in your company, with the same ATW sign-in model as the rest of the network."
  >
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact" class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">Talk to us</a>
      <a href={PRODUCT.hub} class="rounded-lg border-2 border-brand-navy px-6 py-3 text-sm font-semibold text-brand-ink">Open Hub</a>
    </div>
  </PageHero>
</MarketingLayout>
