---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SystemMarketingPage from '../components/marketing/SystemMarketingPage.astro';
import { PRODUCT } from '../lib/site';
import { faqPageJsonLd } from '../lib/seo';

const faqs = [
  {
    q: 'What is ATW Hub?',
    a: 'Hub is the single-tenant productivity suite at hub.atw.net: Mail, Chat, Calendar, Meetings, and Tasks for your organization.',
  },
  {
    q: 'Is Hub a separate purchase?',
    a: 'No. Hub is included with ATW base hosting. It is not a customer-paid SKU.',
  },
  {
    q: 'How does Hub relate to Mail?',
    a: 'Mail is part of Hub. On paid hosting tiers, Mail is included and hosted inboxes draw Credits. Users without a hosted inbox are free named seats. Not available during the trial: Hosted mail inboxes, Sandbox, Hub, ATW Orbit.',
  },
] as const;
---

<MarketingLayout
  title="ATW Hub | Mail, Chat, Calendar, Meetings, Tasks"
  description="Single-tenant productivity for your organization: Mail, Chat, Calendar, Meetings, and Tasks. Included with ATW base hosting."
  canonical="https://atw.net/hub"
  jsonLd={faqPageJsonLd('/hub', faqs)}
>
  <SystemMarketingPage
    systemId="hub"
    headline="Productivity suite for your organization"
    lead="Hub brings Mail, Chat, Calendar, Meetings, and Tasks together at hub.atw.net. It is included with ATW base hosting, not a separate purchase."
    primaryCta={{ label: 'Talk to us', href: '/contact' }}
    secondaryCta={{ label: 'Open Hub', href: PRODUCT.hub }}
    faqs={faqs}
  />
</MarketingLayout>
