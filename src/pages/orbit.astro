---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import OrbitView from '../components/design-preview/b/OrbitView.astro';
import SystemMarketingPage from '../components/marketing/SystemMarketingPage.astro';
import { ORBIT, ORBIT_ONE_LINER } from '../data/orbit';
import { PRODUCT } from '../lib/site';
import { designVariant } from '../lib/designVariant';
import { faqPageJsonLd } from '../lib/seo';

const faqs = [
  {
    q: 'What is ATW Orbit?',
    a: 'ATW Orbit is the productivity orbit next to ATW One. Live today: Mail, Calendar, Meetings, and Messaging (SMS and voice). Coming soon: Docs, Spreadsheets, and Presentations. It is a product label, not a separate per-seat SKU.',
  },
  {
    q: 'Is Orbit included in the trial?',
    a: 'No. Not available during the trial: Hosted mail inboxes, Sandbox, Hub, ATW Orbit. The trial includes ATW One, Workforce, Directory, and ATW AI.',
  },
  {
    q: 'How is Orbit billed?',
    a: 'Included with every paid ATW plan, with unlimited named seats. Apps like Mail are added per user and draw from your organization Credits pool. There is no separate per-seat SKU.',
  },
] as const;
---

<MarketingLayout
  title="ATW Orbit | mail, calendar, meetings, messaging"
  description={`${ORBIT_ONE_LINER} Included with every paid ATW plan next to ATW One.`}
  canonical="https://atw.net/orbit/"
  jsonLd={faqPageJsonLd('/orbit', faqs)}
>
  {
    designVariant === 'b' ? (
      <OrbitView />
    ) : (
      <SystemMarketingPage
        systemId="workspace"
        headline="Each app is a planet in your Orbit"
        lead={ORBIT.lead}
        primaryCta={{ label: 'See pricing', href: '/pricing' }}
        secondaryCta={{ label: ORBIT.consoleLabel, href: PRODUCT.worksuite }}
        faqs={faqs}
      />
    )
  }
</MarketingLayout>
