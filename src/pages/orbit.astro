---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import OrbitView from '../components/design-preview/b/OrbitView.astro';
import SystemMarketingPage from '../components/marketing/SystemMarketingPage.astro';
import { ORBIT, ORBIT_ONE_LINER } from '../data/orbit';
import { PRODUCT } from '../lib/site';
import { designVariant } from '../lib/designVariant';
import { faqPageJsonLd } from '../lib/seo';

const faqs = [
  {
    q: 'What is ATW Orbit?',
    a: 'ATW Orbit is the productivity suite next to ATW One. Mail, Calendar, and Meetings are available today. Messaging, Docs, Spreadsheets, and Presentations are Coming Soon. Orbit ships with every paid ATW plan; there is no separate per-seat Orbit SKU.',
  },
  {
    q: 'Is Mail part of Orbit?',
    a: 'Yes. Mail is an ATW Orbit app. You can add mailboxes for any user; hosted inboxes draw from the organization Credits pool. There is no separate Mail plan.',
  },
  {
    q: 'What is Orbit Messaging?',
    a: 'Orbit Messaging is internal team messaging for people in your organization. It is Coming Soon.',
  },
  {
    q: 'How do I learn more?',
    a: 'See /pricing for the ATW plan that includes Orbit and Hub, or contact us. The trial includes ATW One, Workforce, Directory, and ATW AI only. Mail, Orbit mailboxes, and Sandbox are not part of the trial.',
  },
] as const;
---

<MarketingLayout
  title="ATW Orbit | Mail, Calendar, Meetings"
  description={`${ORBIT_ONE_LINER} Mail draws from your Credits pool.`}
  canonical="https://atw.net/orbit/"
  jsonLd={faqPageJsonLd('/orbit/', faqs)}
>
  {
    designVariant === 'b' ? (
      <OrbitView />
    ) : (
      <SystemMarketingPage
        systemId="workspace"
        headline="Mail, Calendar, and Meetings next to ATW One"
        lead={ORBIT.lead}
        primaryCta={{ label: 'See pricing', href: '/pricing/' }}
        secondaryCta={{ label: ORBIT.consoleLabel, href: PRODUCT.worksuite }}
        faqs={faqs}
        brandWordmark={{
          webp: '/images/logo/atw-orbit-wordmark.webp',
          png: '/images/logo/atw-orbit-wordmark.png',
          alt: 'ATW Orbit logo',
          width: 1163,
          height: 397,
        }}
      />
    )
  }
</MarketingLayout>
