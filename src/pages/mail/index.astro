---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import SystemMarketingPage from '../../components/marketing/SystemMarketingPage.astro';
import { faqPageJsonLd } from '../../lib/seo';

const faqs = [
  {
    q: 'What is ATW Mail?',
    a: 'Hosted business email on your domain with webmail, admin controls, and IMAP/SMTP for any mail client.',
  },
  {
    q: 'Is Mail a separate plan?',
    a: 'No. On paid hosting tiers, Mail is included and hosted inboxes draw Credits. Users without a hosted inbox are free named seats. Not available during the trial: Hosted mail inboxes, Sandbox, Hub, WorkSuite.',
  },
  {
    q: 'How do I get started?',
    a: 'Choose a paid hosting plan on /pricing, or talk to us about migration from Gmail or Microsoft 365. Not available during the trial: Hosted mail inboxes, Sandbox, Hub, WorkSuite.',
  },
] as const;
---

<MarketingLayout
  title="ATW Mail | secure business email"
  description="Professional mailboxes on your domain with webmail, admin controls, and IMAP/SMTP. On paid hosting tiers, Mail is included and hosted inboxes use Credits."
  canonical="https://atw.net/mail"
  jsonLd={faqPageJsonLd('/mail', faqs)}
>
  <SystemMarketingPage
    systemId="mail"
    headline="Secure business email for your organization"
    lead="Professional @yourdomain.com mailboxes with webmail, admin controls, and standard IMAP/SMTP. On paid hosting tiers, Mail is included and hosted inboxes use Credits. Hosted mail inboxes are not available during the trial."
    primaryCta={{ label: 'See pricing', href: '/pricing' }}
    secondaryCta={{ label: 'WorkSuite', href: '/workspace' }}
    faqs={faqs}
  />
</MarketingLayout>
