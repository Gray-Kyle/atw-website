---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ComparePageView from '../../components/marketing/ComparePageView.astro';
import { COMPARE_PAGES } from '../../data/comparePages';
import { breadcrumbListJsonLd, faqPageJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return COMPARE_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const path = `/compare/${page.slug}/`;
const faqLd = faqPageJsonLd(path, page.faqs);
const crumbs = breadcrumbListJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare/' },
  { name: page.h1, path },
]);
---

<MarketingLayout
  title={page.title}
  description={page.description}
  canonical={`https://atw.net${path}`}
  jsonLd={[faqLd, crumbs].filter(Boolean)}
  includeSoftwareApplication={page.slug !== 'google-workspace-email'}
>
  <ComparePageView page={page} />
</MarketingLayout>
