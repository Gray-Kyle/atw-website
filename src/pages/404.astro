---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Page not found" description="The page you requested is not on ATW Network." canonical="https://atw.net/404">
  <section class="container py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">404</p>
    <h1 class="mt-2 text-3xl font-bold">We could not find that page</h1>
    <p class="mt-4 text-muted-foreground">
      Check the URL or return to the home page. Product apps live on dedicated subdomains (one, auth, worksuite).
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">Home</a>
      <a href="/contact" class="rounded-lg border border-border px-6 py-3 text-sm font-semibold">Contact</a>
    </div>
  </section>
</MarketingLayout>
