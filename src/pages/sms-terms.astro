---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LegalShell from '../components/marketing/LegalShell.astro';
---

<MarketingLayout title="SMS Terms" description="SMS terms for ATW" canonical="https://atw.net/sms-terms">
  <LegalShell title="SMS Terms">
    <p class="text-muted-foreground">
      When you opt in to SMS from ATW, you agree to receive messages related to your request, account, or marketing (if you checked the marketing consent box). Message frequency varies. Reply STOP to opt out. Message and data rates may apply. Carriers are not liable for delayed or undelivered messages.
    </p>
  </LegalShell>
</MarketingLayout>
