---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SystemMarketingPage from '../components/marketing/SystemMarketingPage.astro';
import { PRODUCT } from '../lib/site';
import { faqPageJsonLd } from '../lib/seo';

const faqs = [
  {
    q: 'What is ATW WorkSuite?',
    a: 'WorkSuite covers calendar, documents, meetings, and business text/voice messaging alongside One and Mail.',
  },
  {
    q: 'Do I need Mail?',
    a: 'Mail is included in ATW; hosted inboxes use Credits. Users without a hosted inbox are free named seats. Calendar and other WorkSuite tools sit alongside Mail when you need them.',
  },
  {
    q: 'How do I learn more?',
    a: 'Contact us for WorkSuite enablement. For domain email, see Mail: it is included in ATW, and hosted inboxes use Credits.',
  },
] as const;
---

<MarketingLayout
  title="ATW WorkSuite | calendar, docs, meetings, messaging"
  description="Calendar, documents, meetings, and messaging next to ATW One and Mail. Mail is included in ATW; hosted inboxes use Credits."
  canonical="https://atw.net/workspace"
  jsonLd={faqPageJsonLd('/workspace', faqs)}
>
  <SystemMarketingPage
    systemId="workspace"
    headline="Calendar, documents, meetings, and messaging"
    lead="WorkSuite sits next to ATW One so your team can schedule, collaborate, meet, and message without another disconnected suite. Mail is included in ATW; hosted inboxes use Credits."
    primaryCta={{ label: 'Talk to us', href: '/contact' }}
    secondaryCta={{ label: 'Open WorkSuite', href: PRODUCT.worksuite }}
    faqs={faqs}
  />
</MarketingLayout>
