---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SystemMarketingPage from '../components/marketing/SystemMarketingPage.astro';
import { ORBIT_ONE_LINER } from '../data/orbit';
import { PRODUCT } from '../lib/site';
import { faqPageJsonLd } from '../lib/seo';

const faqs = [
  {
    q: 'What is ATW Orbit?',
    a: 'ATW Orbit covers Mail, Calendar, Meetings, and Messaging alongside One today. Docs, Spreadsheets, and Presentations are coming soon. It is a product label, not a separate per-seat SKU. The product console remains on the existing host until the Orbit subdomain is confirmed.',
  },
  {
    q: 'Do I need Mail?',
    a: 'On every paid ATW plan, Mail is included and hosted inboxes draw Credits. Users without a hosted inbox are free named seats. Calendar and other live Orbit tools sit alongside Mail when you need them.',
  },
  {
    q: 'How do I learn more?',
    a: 'See /pricing for paid ATW plans that include Mail, or visit /orbit for the Orbit overview. Not available during the trial: Hosted mail inboxes, Sandbox, Hub, ATW Orbit.',
  },
] as const;
---

<MarketingLayout
  title="ATW Orbit | mail, calendar, meetings, messaging"
  description={`${ORBIT_ONE_LINER} On every paid ATW plan, Mail and related tools draw from your Credits pool.`}
  canonical="https://atw.net/workspace"
  jsonLd={faqPageJsonLd('/workspace', faqs)}
>
  <SystemMarketingPage
    systemId="workspace"
    headline="Each app is a planet in your Orbit"
    lead={`${ORBIT_ONE_LINER} On every paid ATW plan, Mail is included and hosted inboxes use Credits.`}
    primaryCta={{ label: 'Orbit overview', href: '/orbit' }}
    secondaryCta={{ label: 'Open ATW Orbit', href: PRODUCT.worksuite }}
    faqs={faqs}
  />
</MarketingLayout>
