---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ErpPricing from '../components/marketing/ErpPricing.astro';
import PricingFaq from '../components/marketing/PricingFaq.astro';
import {
  ERP_PRIMARY_CTA_LABEL,
  ERP_TRIAL_LABEL,
  ERP_TRIAL_PROMO_LABEL,
} from '../data/erpOfferHome';
import { PRICING_FAQS } from '../data/pricingFaqs';
import { breadcrumbListJsonLd, faqPageJsonLd, softwareApplicationJsonLd } from '../lib/seo';
import { livePath } from '../lib/site';

const pricingFaqLd = faqPageJsonLd('/pricing/', PRICING_FAQS, { includePricing: true });
const softwareWithOffers = softwareApplicationJsonLd({ includeOffers: true });
const crumbs = breadcrumbListJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing/' },
]);
---

<MarketingLayout
  title="ATW pricing | hosting and Credits | ATW.Net"
  description="ATW hosting plus Credits: Trial $0 with 150,000 Credits for 14 days; Starter $299/mo; Growth $1,999/mo; Business $9,999/mo; Enterprise contact us."
  canonical="https://atw.net/pricing/"
  jsonLd={[softwareWithOffers, pricingFaqLd, crumbs].filter(Boolean)}
>
  <section class="border-b border-gray-200 bg-slate-50/90 pt-10">
    <div class="px-4 pb-8 text-center xl-container">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-blue">Commercial hub</p>
      <h1 class="mt-2 font-heading text-3xl font-semibold text-brand-ink sm:text-4xl">ATW pricing</h1>
      <p class="mx-auto mt-3 max-w-2xl text-dark-text">
        Hosting plans with a unified Credits pool and unlimited named seats. {ERP_TRIAL_PROMO_LABEL}.
      </p>
      <nav aria-label="Pricing sections" class="mx-auto mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#one"
          class="inline-flex items-center rounded border-2 border-brand-navy px-5 py-2.5 font-heading text-sm text-brand-ink hover:bg-brand-navy/10"
        >
          Plans
        </a>
        <a
          href="#faq"
          class="inline-flex items-center rounded border border-gray-300 px-5 py-2.5 font-heading text-sm text-brand-ink hover:bg-gray-100"
        >
          FAQ
        </a>
      </nav>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-muted-foreground">
        Need implementation help?
        <a href={livePath('/services')} class="text-primary underline">ATW Services</a>
        scopes separately from these plans.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={livePath('/trial')}
          class="inline-flex items-center rounded bg-brand-navy px-6 py-3 font-heading text-sm text-white hover:bg-brand-navy/90"
        >
          Start {ERP_TRIAL_LABEL}
        </a>
        <a
          href={livePath('/book')}
          class="inline-flex items-center rounded border-2 border-brand-navy px-6 py-3 font-heading text-sm text-brand-ink hover:bg-brand-navy/10"
        >
          {ERP_PRIMARY_CTA_LABEL}
        </a>
      </div>
    </div>
  </section>

  <ErpPricing showTrialBanner={false} />
  <PricingFaq />
</MarketingLayout>
