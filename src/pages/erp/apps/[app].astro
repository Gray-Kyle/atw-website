---
import { Picture } from 'astro:assets';
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import { ERP_APP_SHOWCASE_ENTRIES } from '../../../data/erpOfferHome';
import { breadcrumbListJsonLd } from '../../../lib/seo';
import dashboardImg from '../../../assets/images/marketing/atw-one-dashboard-clean.png';
import crmImg from '../../../assets/images/marketing/erp-product-crm.png';
import financeImg from '../../../assets/images/marketing/erp-product-finance.png';

const showcaseImages = {
  dashboard: {
    src: dashboardImg,
    alt: 'ATW One dashboard home screen with apps launcher and organization overview',
  },
  crm: {
    src: crmImg,
    alt: 'ATW One CRM lead list with company, contact, and pipeline fields',
  },
  finance: {
    src: financeImg,
    alt: 'ATW One finance workspace with invoices, AR metrics, and customer counts',
  },
} as const;

export function getStaticPaths() {
  return ERP_APP_SHOWCASE_ENTRIES.map((app) => ({ params: { app: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const image = showcaseImages[app.slug as keyof typeof showcaseImages];
const crumbs = breadcrumbListJsonLd([
  { name: 'Home', path: '/' },
  { name: 'ATW One', path: '/one/' },
  { name: app.cardTitle, path: `/erp/apps/${app.slug}/` },
]);
---

<MarketingLayout
  title={`ATW One ${app.cardTitle}`}
  description={app.metaDescription}
  canonical={`https://atw.net/erp/apps/${app.slug}/`}
  jsonLd={crumbs}
>
  <section class="container py-16">
    <h1 class="text-3xl font-bold">{app.cardTitle}</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">{app.pageLead}</p>
    <Picture
      src={image.src}
      alt={image.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280]}
      sizes="(max-width: 768px) 95vw, 768px"
      width={960}
      height={490}
      class="mt-8 max-w-3xl rounded-xl border border-border"
      loading="lazy"
    />
    <ul class="mt-8 list-disc space-y-2 pl-5 text-muted-foreground">
      {app.bullets.map((b) => (
        <li>{b}</li>
      ))}
    </ul>
    <div class="mt-10 flex gap-3">
      <a href="/one/" class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">ATW One overview</a>
      <a href="/trial/" class="rounded-lg border border-border px-6 py-3 text-sm font-semibold">Start trial</a>
    </div>
  </section>
</MarketingLayout>
