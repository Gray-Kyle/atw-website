---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
---

<MarketingLayout title="ERP overview" description="ERP on ATW One" canonical="https://atw.net/erp">
  <section class="container py-16">
    <h1 class="text-3xl font-bold">ERP on ATW One</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
      Explore the product tour on <a href="/one" class="text-primary underline">ATW One</a>, module screenshots under{' '}
      <a href="/erp/apps/crm" class="text-primary underline">/erp/apps</a>, and solution pages for CRM, finance, and operations.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/one" class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">Product tour</a>
      <a href="/solutions/erp" class="rounded-lg border border-border px-6 py-3 text-sm font-semibold">ERP solutions</a>
    </div>
  </section>
</MarketingLayout>
