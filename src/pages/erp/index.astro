---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { designVariant } from '../../lib/designVariant';
import { PRODUCT_MARKS, HERO_LOGO_CLASS } from '../../data/productMarks';

const oneMark = PRODUCT_MARKS.one.wordmark!;
---

<MarketingLayout
  title="ERP overview"
  description="ATW One ERP overview: CRM, finance, operations, and custom apps in one workspace with hosting plus Credits billing and unlimited named seats."
  canonical="https://atw.net/erp/"
>
  {
    designVariant === 'b' ? (
      <section class="border-b border-border bg-gradient-to-b from-[#060a12] via-[#0a1628] to-[#0f1f38] px-4 py-16 text-white">
        <div class="container">
          <div class="mb-6">
            <picture>
              <source srcset={oneMark.webp} type="image/webp" />
              <img
                src={oneMark.png}
                alt={oneMark.alt}
                width={oneMark.width}
                height={oneMark.height}
                class={HERO_LOGO_CLASS}
                loading="eager"
                decoding="async"
              />
            </picture>
          </div>
          <h1 class="text-3xl font-bold text-white">ERP on ATW One</h1>
          <p class="mt-4 max-w-2xl text-zinc-300">
            Explore the product tour on <a href="/one" class="text-[#7ee0ff] underline">ATW One</a>, module
            screenshots under <a href="/erp/apps/crm" class="text-[#7ee0ff] underline">/erp/apps</a>, and
            solution pages for CRM, finance, and operations.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/one" class="rounded-lg bg-[#5b9bff] px-6 py-3 text-sm font-semibold text-[#06101c]">
              Product tour
            </a>
            <a
              href="/solutions/erp"
              class="rounded-lg border border-white/40 px-6 py-3 text-sm font-semibold text-white"
            >
              ERP solutions
            </a>
          </div>
        </div>
      </section>
    ) : (
      <section class="container py-16">
        <h1 class="text-3xl font-bold">ERP on ATW One</h1>
        <p class="mt-4 max-w-2xl text-muted-foreground">
          Explore the product tour on <a href="/one" class="text-primary underline">ATW One</a>, module
          screenshots under <a href="/erp/apps/crm" class="text-primary underline">/erp/apps</a>, and solution
          pages for CRM, finance, and operations.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/one" class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">
            Product tour
          </a>
          <a href="/solutions/erp" class="rounded-lg border border-border px-6 py-3 text-sm font-semibold">
            ERP solutions
          </a>
        </div>
      </section>
    )
  }
</MarketingLayout>
