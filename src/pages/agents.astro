---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import { WORKFORCE } from '../data/workforce';
import { PRODUCT } from '../lib/site';
import { designVariant } from '../lib/designVariant';
import { PRODUCT_MARKS, HERO_LOGO_CLASS } from '../data/productMarks';

const workforceMark = PRODUCT_MARKS.workforce.wordmark!;
---

<MarketingLayout
  title="ATW Workforce"
  description={WORKFORCE.oneLiner}
  canonical="https://atw.net/agents/"
>
  {
    designVariant === 'b' ? (
      <section class="border-b border-border bg-gradient-to-b from-[#060a12] via-[#0a1628] to-[#0f1f38] px-4 pb-16 pt-16 text-white">
        <div class="container max-w-3xl">
          <div class="mb-6">
            <picture>
              <source srcset={workforceMark.webp} type="image/webp" />
              <img
                src={workforceMark.png}
                alt={workforceMark.alt}
                width={workforceMark.width}
                height={workforceMark.height}
                class={HERO_LOGO_CLASS}
                loading="eager"
                decoding="async"
              />
            </picture>
          </div>
          <h1 class="mt-3 font-heading text-4xl font-bold tracking-tight text-white sm:text-5xl">
            ATW Workforce
          </h1>
          <p class="mt-4 text-lg text-zinc-300">{WORKFORCE.oneLiner}</p>
          <p class="mt-4 text-sm text-[#a8b6c9]">{WORKFORCE.siblingNote}</p>
          <p class="mt-3 text-sm text-[#a8b6c9]">
            {WORKFORCE.autopilotHonest}
            <span class="ml-2 inline-flex rounded border border-[#5b9bff]/35 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#7ee0ff]">
              {WORKFORCE.comingOnlineLabel}
            </span>
          </p>
          <p class="mt-3 text-xs text-[#a8b6c9]">{WORKFORCE.comingOnlineNote}</p>
          <ul class="mt-8 max-w-xl space-y-2 text-left text-sm text-[#c5d0e0]">
            {WORKFORCE.safeBullets.map((item) => (
              <li class="border-t border-white/10 pt-2">{item}</li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-[#a8b6c9]">{WORKFORCE.trialNote}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={PRODUCT.workforce}
              class="rounded-lg bg-[#5b9bff] px-6 py-3 text-sm font-semibold text-[#06101c]"
            >
              {WORKFORCE.consoleLabel}
            </a>
            <a
              href="/one/"
              class="rounded-lg border-2 border-white/50 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10"
            >
              Explore ATW One
            </a>
            <a
              href="/contact"
              class="rounded-lg border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:bg-white/5"
            >
              Contact sales
            </a>
          </div>
        </div>
      </section>
    ) : (
      <PageHero title="ATW Workforce" description={WORKFORCE.oneLiner}>
        <p class="mx-auto mt-4 max-w-2xl text-center text-sm text-muted-foreground">
          {WORKFORCE.siblingNote}
        </p>
        <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-muted-foreground">
          {WORKFORCE.autopilotHonest}
          <span class="ml-2 inline-flex rounded border border-border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide">
            {WORKFORCE.comingOnlineLabel}
          </span>
        </p>
        <p class="mx-auto mt-3 max-w-2xl text-center text-xs text-muted-foreground">
          {WORKFORCE.comingOnlineNote}
        </p>
        <ul class="mx-auto mt-8 max-w-xl space-y-2 text-left text-sm text-muted-foreground">
          {WORKFORCE.safeBullets.map((item) => (
            <li class="border-t border-border pt-2">{item}</li>
          ))}
        </ul>
        <p class="mx-auto mt-6 max-w-xl text-center text-sm text-muted-foreground">{WORKFORCE.trialNote}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={PRODUCT.workforce} class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">
            {WORKFORCE.consoleLabel}
          </a>
          <a href="/one/" class="rounded-lg border-2 border-brand-navy px-6 py-3 text-sm font-semibold text-brand-ink">
            Explore ATW One
          </a>
          <a href="/contact" class="rounded-lg border border-border px-6 py-3 text-sm font-semibold text-brand-ink">
            Contact sales
          </a>
        </div>
      </PageHero>
    )
  }
</MarketingLayout>
