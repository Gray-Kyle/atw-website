---
import MarketingLayout from '../layouts/MarketingLayout.astro';

const contactInfo = [
  {
    title: 'Phone',
    description: 'Mon–Fri, 8am–5pm',
    content: '+1 (330) 333-2256',
    href: 'tel:+13303332256',
    smsHref: 'sms:+13303332256',
  },
  {
    title: 'Email',
    description: 'We reply within 24 hours',
    content: 'support@atw.net',
    href: 'mailto:support@atw.net',
  },
  {
    title: 'Office',
    description: 'Visit us',
    content: '13940 Cedar Rd 438',
    subContent: 'University Heights OH 44118-3204',
    href: 'https://maps.google.com/?q=13940+Cedar+Rd+438+University+Heights+OH+44118',
    external: true,
  },
  {
    title: 'Hours',
    description: 'Business hours',
    content: 'Mon–Fri: 8am–5pm',
    subContent: 'Sat–Sun: Closed',
  },
];

const faqs = [
  {
    q: 'What are your typical response times?',
    a: 'We aim to respond within 24 hours on business days. For urgent matters, please call us.',
  },
  {
    q: 'Do you offer remote consultations?',
    a: 'Yes. We offer in-person and remote consultations via video to suit your location and preference.',
  },
  {
    q: 'What industries do you serve?',
    a: 'We work with manufacturing, retail, healthcare, technology, and many other industries.',
  },
];
---

<MarketingLayout
  title="Contact ATW Network"
  description="Get in touch with ATW Network. Phone, email, and office hours for sales and support."
  canonical="https://atw.net/contact"
>
  <section class="relative overflow-hidden border-b bg-gradient-to-b from-muted/60 to-white px-4 py-16 sm:py-20">
    <div class="container relative mx-auto max-w-6xl text-center">
      <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">Get in touch</h1>
      <p class="text-base text-muted-foreground sm:text-lg">
        Tell us a bit about yourself and how we can help. We will respond within 24 hours.
      </p>
    </div>
  </section>

  <section class="px-4 py-10 sm:py-14">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-[1fr,340px]">
        <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
          <h2 class="text-xl font-semibold sm:text-2xl">Contact form</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Submit inquiries with Turnstile protection. Leads go to ATW CRM via same-origin API on atw.net.
          </p>
          <div
            id="atw-contact-form-root"
            class="mt-6"
            data-turnstile-site-key={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''}
          ></div>
        </div>

        <div class="grid grid-cols-2 gap-3 lg:grid-cols-1">
          {
            contactInfo.map((item) => (
              <div class="rounded-xl border border-border p-4 sm:p-5">
                <h3 class="text-base font-semibold">{item.title}</h3>
                <p class="text-xs text-muted-foreground sm:text-sm">{item.description}</p>
                <div class="mt-2 text-sm">
                  {item.href ? (
                    <a href={item.href} class="font-medium text-primary hover:underline" target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
                      {item.content}
                    </a>
                  ) : (
                    <p class="font-medium">{item.content}</p>
                  )}
                  {item.smsHref ? (
                    <p class="mt-1">
                      <a href={item.smsHref} class="text-primary hover:underline">Text (SMS)</a>
                    </p>
                  ) : null}
                  {item.subContent ? <p class="mt-1 text-muted-foreground">{item.subContent}</p> : null}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="border-t bg-muted/30 px-4 py-10 sm:py-14">
    <div class="container mx-auto max-w-3xl">
      <h2 class="mb-6 text-center text-2xl font-bold sm:text-3xl">Frequently asked questions</h2>
      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <div class="rounded-xl border border-border bg-card p-5">
              <h3 class="text-base font-semibold sm:text-lg">{faq.q}</h3>
              <p class="mt-2 text-sm text-muted-foreground">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <script src="/js/contact-form.js" defer></script>
</MarketingLayout>
