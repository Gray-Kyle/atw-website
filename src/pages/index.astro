---
import { getImage } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HomeHero from '../components/marketing/HomeHero.astro';
import OfferLanes from '../components/marketing/OfferLanes.astro';
import HomeSections from '../components/marketing/HomeSections.astro';
import ErpPricing from '../components/marketing/ErpPricing.astro';
import dashboardPreview from '../assets/images/marketing/atw-one-dashboard-clean.png';

/** Mobile LCP candidate: hero dashboard (AVIF ~640w). */
const lcpImage = await getImage({
  src: dashboardPreview,
  format: 'avif',
  width: 640,
});
---

<MarketingLayout
  title="ATW One | one workspace with Credits-based billing | ATW.Net"
  description="ATW One runs customers, sales, finance, and operations in one workspace with hosting plus a unified Credits pool, unlimited named seats, and a 14-day Trial."
  canonical="https://atw.net/"
  includeSoftwareApplication
  lcpImageHref={lcpImage.src}
  lcpImageType="image/avif"
  lcpImageMedia="(min-width: 1024px)"
>
  <HomeHero />
  <OfferLanes />
  <HomeSections />
  <ErpPricing />
</MarketingLayout>
