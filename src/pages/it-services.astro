---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="IT Services" description="Managed IT and implementation services" canonical="https://atw.net/it-services">
  <section class="container max-w-3xl py-16">
    <h1 class="text-3xl font-bold">IT services</h1>
    <p class="mt-4 text-muted-foreground">
      ATW Services covers implementation, migration, and ongoing support for ATW One and partner stacks. See{' '}
      <a href="/services" class="text-primary underline">ATW Services</a> for delivery tracks and FAQs.
    </p>
    <a href="/contact" class="mt-8 inline-flex rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white">Contact us</a>
  </section>
</MarketingLayout>
