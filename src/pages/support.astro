---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import CtaBand from '../components/marketing/CtaBand.astro';
import {
  AUTH_SIGNIN,
  MAIL_WEBMAIL_INBOX,
  PRODUCT,
} from '../lib/site';

const channels = [
  {
    title: 'Email',
    detail: 'support@atw.net',
    note: 'Best for tickets, account issues, and product questions. We reply on business days.',
    href: 'mailto:support@atw.net',
  },
  {
    title: 'Phone',
    detail: '+1 (330) 333-2256',
    note: 'Mon-Fri, 8am-5pm ET. Call for time-sensitive account or outage help.',
    href: 'tel:+13303332256',
  },
  {
    title: 'Contact form',
    detail: 'Submit a written request',
    note: 'Use the form when you prefer a structured message. For sales or new projects, start there too.',
    href: '/contact',
  },
  {
    title: 'Book a call',
    detail: 'Schedule time with ATW',
    note: 'Walkthroughs, onboarding questions, and planned reviews.',
    href: '/book',
  },
];

const productHelp = [
  {
    title: 'Sign in',
    description: 'ATW.Net account sign-in for One, ATW Orbit, Hub, and Mail.',
    href: AUTH_SIGNIN,
  },
  {
    title: 'ATW One',
    description: 'Sales, finance, and operations workspace. Open the app for in-product help.',
    href: PRODUCT.one,
  },
  {
    title: 'ATW Orbit',
    description: 'Mail, Calendar, and Meetings for your organization. Messaging and Docs suite Coming Soon.',
    href: PRODUCT.worksuite,
  },
  {
    title: 'Hub',
    description: 'Outlook-like inbox and workspace client. Connects to Orbit, Google Workspace, Microsoft Teams, and Outlook.',
    href: PRODUCT.hub,
  },
  {
    title: 'Mail',
    description: 'Webmail inbox for ATW Orbit Mail.',
    href: MAIL_WEBMAIL_INBOX,
  },
  {
    title: 'Status',
    description: 'Service status for marketing and product hosts.',
    href: '/status',
  },
];

const faqs = [
  {
    q: 'How fast do you respond?',
    a: 'We aim to reply to support@atw.net within one business day (Mon-Fri, 8am-5pm ET). For urgent outages or locked accounts during those hours, call +1 (330) 333-2256.',
  },
  {
    q: 'How do I open a support request?',
    a: 'Email support@atw.net with your account or organization name, the product you use, and what you need. You can also use the contact form or book a call for a scheduled review.',
  },
  {
    q: 'Where do I find product docs and status?',
    a: 'Sign in at auth.atw.net, then open the product you use. One AI help lives at ai.atw.net. For host-level status, see /status on this site.',
  },
  {
    q: 'Is this the right place for sales or a new project?',
    a: 'Support is for existing customers and product help. For sales, demos, or new work, use Contact or book a call.',
  },
];
---

<MarketingLayout
  title="Support"
  description="Help for ATW One, ATW Orbit, Hub, Mail, and Services customers. Email, phone, and product links."
  canonical="https://atw.net/support"
>
  <PageHero
    title="Support"
    description="Help for existing ATW customers and products. For sales or general inquiries, use Contact."
  >
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="mailto:support@atw.net"
        class="rounded-lg bg-brand-navy px-6 py-3 text-sm font-semibold text-white"
      >
        Email support
      </a>
      <a
        href="tel:+13303332256"
        class="rounded-lg border-2 border-brand-navy px-6 py-3 text-sm font-semibold text-brand-ink"
      >
        Call us
      </a>
      <a
        href="/contact"
        class="rounded-lg border border-border px-6 py-3 text-sm font-semibold"
      >
        Contact form
      </a>
    </div>
  </PageHero>

  <section class="border-b border-border px-4 py-14 sm:py-16">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">How to reach us</h2>
      <p class="mt-3 text-muted-foreground">
        Pick the channel that fits. Email is the default ticket path; phone is for business-hour urgency.
      </p>
      <dl class="mt-10 divide-y divide-border border-t border-border">
        {
          channels.map((channel) => (
            <div class="grid gap-2 py-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
                {channel.title}
              </dt>
              <dd>
                <a href={channel.href} class="font-medium text-primary hover:underline">
                  {channel.detail}
                </a>
                <p class="mt-1 text-sm text-muted-foreground">{channel.note}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="border-b border-border px-4 py-14 sm:py-16">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Product help</h2>
      <p class="mt-3 text-muted-foreground">
        Sign in, then open the app you use. In-product help and One AI are available after authentication.
      </p>
      <ul class="mt-10 divide-y divide-border border-t border-border">
        {
          productHelp.map((item) => (
            <li class="flex flex-wrap items-baseline justify-between gap-3 py-5">
              <div class="min-w-0 max-w-xl">
                <a href={item.href} class="text-lg font-semibold text-primary hover:underline">
                  {item.title}
                </a>
                <p class="mt-1 text-sm text-muted-foreground">{item.description}</p>
              </div>
              <a
                href={item.href}
                class="shrink-0 text-sm font-medium text-brand-ink underline decoration-brand-navy/30"
              >
                Open
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sm text-muted-foreground">
        Signed-in AI help for ATW One:{' '}
        <a href={PRODUCT.ai} class="text-primary underline">ai.atw.net</a>
      </p>
    </div>
  </section>

  <section class="px-4 py-14 sm:py-16">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">FAQ</h2>
      <p class="mt-3 text-muted-foreground">
        Short answers for customers. Need something else? Email support or use Contact.
      </p>
      <div class="mt-10 space-y-6">
        {
          faqs.map((faq) => (
            <div class="border-b border-border pb-6">
              <h3 class="text-lg font-semibold text-brand-ink">{faq.q}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Sales or a new project?"
    description="Support is for existing customers. Contact us for demos, quotes, and new work."
  >
    <a href="/contact" class="rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-navy">
      Contact
    </a>
    <a
      href="/book"
      class="rounded-lg border border-white/40 px-6 py-3 text-sm font-semibold text-white"
    >
      Book a call
    </a>
  </CtaBand>
</MarketingLayout>
