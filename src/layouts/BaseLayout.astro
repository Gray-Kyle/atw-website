---
import '../styles/global.css';
import JsonLd from '../components/seo/JsonLd.astro';
import PreviewBanner from '../components/design-preview/PreviewBanner.astro';
import PreviewMotion from '../components/design-preview/PreviewMotion.astro';
import {
  designVariant,
  isDesignPreview,
  isDesignVariant,
} from '../lib/designVariant';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_TYPE,
  DEFAULT_OG_IMAGE_WIDTH,
  SITE_NAME,
  TWITTER_HANDLE,
  absoluteUrl,
  organizationJsonLd,
  softwareApplicationJsonLd,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Extra JSON-LD graphs (FAQPage, etc.). Organization is always included. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  /** Include SoftwareApplication for ATW One (Offers are added on /pricing via jsonLd). */
  includeSoftwareApplication?: boolean;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  noindex?: boolean;
  /** Optional LCP image URL to preload (AVIF/WebP/PNG from astro:assets). */
  lcpImageHref?: string;
  lcpImageType?: string;
  /** Optional media query so below-fold mobile heroes are not preloaded. */
  lcpImageMedia?: string;
}

const {
  title,
  description = 'ATW One is our ERP/CRM platform. ATW Services builds custom ERP around One, or implements Zoho, Salesforce, Odoo, and AWS when you stay on your stack.',
  canonical,
  jsonLd,
  includeSoftwareApplication = false,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  ogImageWidth = DEFAULT_OG_IMAGE_WIDTH,
  ogImageHeight = DEFAULT_OG_IMAGE_HEIGHT,
  ogImageType = DEFAULT_OG_IMAGE_TYPE,
  noindex = false,
  lcpImageHref,
  lcpImageType,
  lcpImageMedia,
} = Astro.props;

const forceNoindex = isDesignPreview || noindex;
const fullTitle = title.includes('ATW') ? title : `${title} | ATW`;
const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname);
const imageUrl = absoluteUrl(ogImage);

const graphs: Record<string, unknown>[] = [organizationJsonLd()];
if (includeSoftwareApplication) {
  graphs.push(softwareApplicationJsonLd());
}
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    for (const item of jsonLd) {
      if (item) graphs.push(item);
    }
  } else {
    graphs.push(jsonLd);
  }
}

const htmlAttrs: Record<string, string> = { lang: 'en' };
if (isDesignVariant) {
  htmlAttrs['data-design-variant'] = designVariant;
}
if (isDesignPreview) {
  htmlAttrs['data-design-preview'] = 'true';
}

/** Sticky preview chrome is in-flow; only production needs large offset for fixed header. */
const mainPad = isDesignPreview ? 'pt-8 pb-16 md:pt-10' : 'pt-24 pb-16 md:pt-28';
---

<!doctype html>
<html {...htmlAttrs}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {forceNoindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    {forceNoindex ? <meta name="googlebot" content="noindex, nofollow" /> : null}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {!forceNoindex ? <link rel="sitemap" href="/sitemap-index.xml" /> : null}
    {
      designVariant === 'a' ? (
        <>
          <link rel="preload" href="/fonts/preview/figtree-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/preview/outfit-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
        </>
      ) : designVariant === 'b' ? (
        <>
          <link rel="preload" href="/fonts/preview/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/preview/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
        </>
      ) : (
        <>
          <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/lexend-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
        </>
      )
    }
    {
      lcpImageHref ? (
        <link
          rel="preload"
          as="image"
          href={lcpImageHref}
          type={lcpImageType}
          media={lcpImageMedia}
          fetchpriority="high"
        />
      ) : null
    }
    {!forceNoindex ? <link rel="canonical" href={canonicalUrl} /> : null}
    <title>{fullTitle}</title>
    <slot name="head" />
    {designVariant === 'a' ? <link rel="stylesheet" href="/design-preview/a.css" /> : null}
    {designVariant === 'b' ? <link rel="stylesheet" href="/design-preview/b.css" /> : null}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {!forceNoindex ? <JsonLd data={graphs} /> : null}
  </head>
  <body
    class="min-h-screen antialiased"
    data-design-preview={isDesignPreview ? 'true' : undefined}
    data-design-variant={isDesignVariant ? designVariant : undefined}
  >
    <div class="sticky top-0 z-[60]">
      <PreviewBanner />
      <slot name="header" />
    </div>
    <main class={mainPad}>
      <slot />
    </main>
    <slot name="footer" />
    <PreviewMotion />
  </body>
</html>
