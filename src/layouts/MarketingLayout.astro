---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeaderA from '../components/design-preview/a/Header.astro';
import HeaderB from '../components/design-preview/b/Header.astro';
import { designVariant } from '../lib/designVariant';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  includeSoftwareApplication?: boolean;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  noindex?: boolean;
  lcpImageHref?: string;
  lcpImageType?: string;
  lcpImageMedia?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  {
    designVariant === 'a' ? (
      <HeaderA slot="header" />
    ) : designVariant === 'b' ? (
      <HeaderB slot="header" />
    ) : (
      <SiteHeader slot="header" />
    )
  }
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>
