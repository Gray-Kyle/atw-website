---
import { AUTH_SIGNIN, livePath } from '../lib/site';

const companyLinks = [
  { title: 'Home', href: '/' },
  { title: 'Services', href: livePath('/services') },
  { title: 'Careers', href: livePath('/careers') },
  { title: 'Why Us', href: livePath('/why-us') },
  { title: 'Pricing', href: '/pricing' },
];

const supportLinks = [
  { title: 'Our Blog', href: livePath('/blog') },
  { title: 'Account', href: AUTH_SIGNIN },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[#060a12] pb-6 pt-14 text-zinc-400 sm:pt-16">
  <div class="xl-container">
    <div class="-mx-4 flex flex-wrap">
      <div class="w-full px-4 sm:w-1/2 md:w-5/12 lg:w-3/12">
        <div class="mb-20 max-w-[330px]">
          <a href="/" class="mb-6 inline-block">
            <img
              src="/images/logo/logo_light.png"
              alt="ATW Network"
              width="215"
              height="50"
              class="h-auto w-36 object-contain object-left sm:w-40"
              loading="lazy"
            />
          </a>
          <p class="mb-10 text-base text-zinc-500">
            ATW One: one workspace for sales, finance, and operations.
          </p>
        </div>
      </div>

      <div class="w-1/2 px-4 md:w-3/12">
        <div class="mb-20">
          <h3 class="mb-9 font-heading text-2xl font-medium text-zinc-100">Company</h3>
          <ul class="space-y-4">
            {
              companyLinks.map((link) => (
                <li>
                  <a href={link.href} class="font-heading text-base hover:text-[#9db6ff]">
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="w-1/2 px-4 md:w-3/12">
        <div class="mb-20">
          <h3 class="mb-9 font-heading text-2xl font-medium text-zinc-100">Support</h3>
          <ul class="space-y-4">
            {
              supportLinks.map((link) => (
                <li>
                  <a href={link.href} class="font-heading text-base hover:text-[#9db6ff]">
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="w-full px-4 sm:w-1/2 md:w-5/12 lg:w-3/12">
        <div class="mb-20">
          <h3 class="mb-9 font-heading text-2xl font-medium text-zinc-100">Get in touch</h3>
          <div class="space-y-7">
            <div>
              <p class="font-heading text-base text-zinc-500">Customer care</p>
              <a href="tel:+13303332256" class="font-heading text-base text-zinc-200 hover:text-[#9db6ff]">
                +1 (330) 333-2256
              </a>
            </div>
            <div>
              <p class="font-heading text-base text-zinc-500">Need live support?</p>
              <a
                href="mailto:support@atw.net"
                class="font-heading text-base text-zinc-200 hover:text-[#9db6ff]"
              >
                support@atw.net
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="-mx-4 flex flex-wrap py-5 md:py-7">
        <div class="w-full px-4 md:w-2/3">
          <div class="mb-5 flex flex-wrap items-center justify-center gap-4 border-b border-white/10 pb-5 md:mb-0 md:justify-start md:border-0 md:pb-0">
            <a href={livePath('/privacy-policy')} class="font-heading text-base hover:text-[#9db6ff]">
              Privacy Policy
            </a>
            <a href={livePath('/cookies')} class="font-heading text-base hover:text-[#9db6ff]">
              Cookie settings
            </a>
            <a href={livePath('/privacy-choices')} class="font-heading text-base hover:text-[#9db6ff]">
              Your Privacy Choices
            </a>
            <a href={livePath('/terms')} class="font-heading text-base hover:text-[#9db6ff]">
              Terms
            </a>
            <a href="/contact" class="font-heading text-base hover:text-[#9db6ff]"> Support </a>
          </div>
        </div>
        <div class="w-full px-4 md:w-1/3">
          <p class="text-center font-heading text-base text-zinc-400 md:text-right">
            © {year} ATW.Net. All rights reserved
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
