---
import { findMarketingSystem } from '../../lib/marketingNav';
import { designVariant } from '../../lib/designVariant';
import { HERO_LOGO_CLASS } from '../../data/productMarks';

type Faq = { q: string; a: string };

type BrandWordmark = {
  webp?: string;
  png: string;
  alt: string;
  width: number;
  height: number;
};

type BrandMarkLabel = BrandWordmark & { label: string };

type Props = {
  systemId: string;
  headline: string;
  lead: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  faqs: readonly Faq[];
  /** Transparent product wordmark for dark hero backgrounds only. */
  productWordmarkSrc?: string;
  productWordmarkPng?: string;
  productWordmarkAlt?: string;
  productWordmarkWidth?: number;
  productWordmarkHeight?: number;
  /** Structured brand for Option B (preferred over legacy wordmark props). */
  brandWordmark?: BrandWordmark;
  brandMarkWithLabel?: BrandMarkLabel;
  /** Orbit wordmark + Mail icon combo (Mail is an Orbit app). */
  brandOrbitWithMail?: boolean;
};

const {
  systemId,
  headline,
  lead,
  primaryCta,
  secondaryCta,
  faqs,
  productWordmarkSrc,
  productWordmarkPng,
  productWordmarkAlt = 'ATW',
  productWordmarkWidth = 280,
  productWordmarkHeight = 64,
  brandWordmark,
  brandMarkWithLabel,
  brandOrbitWithMail = false,
} = Astro.props;
const system = findMarketingSystem(systemId);
if (!system) {
  throw new Error(`Unknown marketing system: ${systemId}`);
}

const legacyWordmark: BrandWordmark | null =
  productWordmarkPng || productWordmarkSrc
    ? {
        webp: productWordmarkSrc?.endsWith('.webp') ? productWordmarkSrc : undefined,
        png: productWordmarkPng || productWordmarkSrc!,
        alt: productWordmarkAlt,
        width: productWordmarkWidth,
        height: productWordmarkHeight,
      }
    : null;

const wordmark = brandWordmark || legacyWordmark;
const showBrand = Boolean(wordmark || brandMarkWithLabel || brandOrbitWithMail);
const darkHero = showBrand || designVariant === 'b';
---

<main class="min-h-screen">
  <section
    class:list={[
      'border-b border-border pt-16',
      darkHero
        ? 'bg-gradient-to-b from-[#060a12] via-[#0a1628] to-[#0f1f38] text-white'
        : 'bg-gradient-to-b from-slate-50 to-white',
    ]}
  >
    <div class="container px-4 pb-16 pt-8">
      {
        brandOrbitWithMail && wordmark ? (
          <div class="mb-6 flex flex-wrap items-center gap-3 sm:gap-4">
            <picture>
              {wordmark.webp ? <source srcset={wordmark.webp} type="image/webp" /> : null}
              <img
                src={wordmark.png}
                alt={wordmark.alt}
                width={wordmark.width}
                height={wordmark.height}
                class={HERO_LOGO_CLASS}
                loading="eager"
                decoding="async"
              />
            </picture>
            <img
              src="/images/atw-marks/system-mail.svg"
              alt=""
              width={64}
              height={64}
              class="h-10 w-10 object-contain sm:h-12 sm:w-12"
              aria-hidden="true"
            />
            <span class="sr-only">Mail</span>
          </div>
        ) : brandMarkWithLabel ? (
          <div class="mb-6 flex flex-wrap items-center gap-3 sm:gap-4">
            <picture>
              {brandMarkWithLabel.webp ? (
                <source srcset={brandMarkWithLabel.webp} type="image/webp" />
              ) : null}
              <img
                src={brandMarkWithLabel.png}
                alt={brandMarkWithLabel.alt}
                width={brandMarkWithLabel.width}
                height={brandMarkWithLabel.height}
                class="h-14 w-auto max-w-[5.5rem] object-contain object-left sm:h-16 md:h-[4.5rem]"
                loading="eager"
                decoding="async"
              />
            </picture>
            <span class="font-heading text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              {brandMarkWithLabel.label}
            </span>
          </div>
        ) : wordmark ? (
          <div class="mb-6">
            <picture>
              {wordmark.webp ? <source srcset={wordmark.webp} type="image/webp" /> : null}
              <img
                src={wordmark.png}
                alt={wordmark.alt}
                width={wordmark.width}
                height={wordmark.height}
                class={HERO_LOGO_CLASS}
                loading="eager"
                decoding="async"
              />
            </picture>
          </div>
        ) : (
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-blue">ATW {system.title}</p>
        )
      }
      <h1
        class:list={[
          'mt-3 max-w-3xl font-heading text-4xl font-bold sm:text-5xl',
          darkHero ? 'text-white' : 'text-foreground',
        ]}
      >
        {headline}
      </h1>
      <p
        class:list={[
          'mt-4 max-w-2xl text-lg',
          darkHero ? 'text-zinc-300' : 'text-muted-foreground',
        ]}
      >
        {lead}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={primaryCta.href}
          class:list={[
            'inline-flex items-center rounded px-6 py-3 font-heading text-sm',
            darkHero
              ? designVariant === 'b'
                ? 'bg-[#5b9bff] text-[#06101c] hover:brightness-110'
                : 'bg-white text-brand-navy hover:bg-white/90'
              : 'bg-brand-navy text-white hover:bg-brand-navy/90',
          ]}
        >
          {primaryCta.label}
        </a>
        {
          secondaryCta ? (
            <a
              href={secondaryCta.href}
              class:list={[
                'inline-flex items-center rounded border-2 px-6 py-3 font-heading text-sm',
                darkHero
                  ? 'border-white/50 text-white hover:bg-white/10'
                  : 'border-brand-navy text-foreground hover:bg-brand-navy/10',
              ]}
            >
              {secondaryCta.label}
            </a>
          ) : null
        }
      </div>
    </div>
  </section>

  <section class="container px-4 py-16">
    <h2 class="text-2xl font-semibold">What's inside</h2>
    <p class="mt-2 max-w-2xl text-muted-foreground">{system.summary}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        system.apps.map((app) => (
          <article class="rounded-xl border border-border bg-card p-5">
            <h3 class="text-lg font-semibold">
              <a href={app.href} class="hover:text-primary">
                {app.title}
              </a>
            </h3>
            <p class="mt-1 text-sm text-muted-foreground">{app.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {app.modules.map((mod) => (
                <li>
                  <a
                    href={mod.href}
                    class="inline-flex rounded-full border border-border px-3 py-1 text-sm hover:bg-accent"
                  >
                    {mod.title}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-muted-foreground">
      See the full catalog on <a href="/systems/" class="text-primary underline">Systems</a>.
    </p>
  </section>

  <section class="border-t border-border bg-muted/30 py-16">
    <div class="container max-w-3xl px-4">
      <h2 class="text-2xl font-semibold">FAQ</h2>
      <dl class="mt-6 space-y-6">
        {
          faqs.map((faq) => (
            <div>
              <dt class="font-medium text-foreground">{faq.q}</dt>
              <dd class="mt-1 text-muted-foreground">{faq.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</main>
