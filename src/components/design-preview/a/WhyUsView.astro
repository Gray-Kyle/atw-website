---
import { WHY_US } from '../../../data/whyUs';
import { ERP_PRIMARY_CTA_LABEL, ERP_TRIAL_LABEL } from '../../../data/erpOfferHome';
import { livePath } from '../../../lib/site';
---

<section class="border-b border-border bg-white/60 px-4 pb-14 pt-8">
  <div class="xl-container max-w-4xl text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-blue">{WHY_US.eyebrow}</p>
    <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight text-brand-ink sm:text-5xl md:text-6xl">{WHY_US.title}</h1>
    <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-dark-text">{WHY_US.paragraph}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={livePath('/book')} class="rounded-xl bg-brand-ink px-7 py-3.5 text-sm font-semibold text-white">{ERP_PRIMARY_CTA_LABEL}</a>
      <a href={livePath('/trial')} class="rounded-xl border border-brand-ink/15 bg-white px-7 py-3.5 text-sm font-semibold text-brand-ink">Start {ERP_TRIAL_LABEL}</a>
    </div>
  </div>
</section>

<section class="px-4 py-20" data-preview-animate>
  <div class="xl-container max-w-5xl">
    <div class="grid gap-10 md:grid-cols-2">
      {
        WHY_US.pillars.map((pillar) => (
          <div class="border-t border-brand-ink/10 pt-6">
            <h2 class="font-heading text-xl font-semibold text-brand-ink">{pillar.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-dark-text">{pillar.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="border-y border-border bg-[#f8fbff] px-4 py-20" data-preview-animate>
  <div class="xl-container max-w-5xl">
    <h2 class="text-center font-heading text-3xl font-semibold text-brand-ink">{WHY_US.comparisonTitle}</h2>
    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[680px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-brand-ink/15">
            <th class="py-4 pr-4 font-semibold text-brand-ink">Factor</th>
            <th class="py-4 pr-4 font-semibold text-muted-foreground">Typical vendors</th>
            <th class="py-4 font-semibold text-brand-blue">ATW</th>
          </tr>
        </thead>
        <tbody>
          {
            WHY_US.comparisonRows.map((row) => (
              <tr class="border-b border-brand-ink/8 align-top">
                <td class="py-5 pr-4 font-medium text-brand-ink">{row.factor}</td>
                <td class="py-5 pr-4 text-muted-foreground">{row.typical}</td>
                <td class="py-5 text-brand-ink">{row.atw}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mx-auto mt-10 max-w-3xl text-center text-lg text-dark-text">{WHY_US.closing}</p>
  </div>
</section>

<section class="px-4 py-16">
  <div class="xl-container overflow-hidden rounded-[2rem] bg-brand-ink px-8 py-12 text-center text-white">
    <h2 class="font-heading text-3xl font-semibold">Work directly with ATW</h2>
    <p class="mx-auto mt-3 max-w-xl text-white/75">Book a review or start a trial on ATW One.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={livePath('/book')} class="rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-ink">Book a call</a>
      <a href={livePath('/contact')} class="rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white">Contact</a>
    </div>
  </div>
</section>
