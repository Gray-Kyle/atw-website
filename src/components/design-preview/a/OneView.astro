---
import { Picture } from 'astro:assets';
import { ERP_HERO, ERP_TRIAL_LABEL, ERP_APP_SHOWCASE_ENTRIES } from '../../../data/erpOfferHome';
import { ONE_FAQS } from '../../../data/oneFaqs';
import { PRODUCT, livePath } from '../../../lib/site';
import dashboardImg from '../../../assets/images/marketing/atw-one-dashboard-clean.png';
import crmImg from '../../../assets/images/marketing/erp-product-crm.png';
import financeImg from '../../../assets/images/marketing/erp-product-finance.png';

const showcaseImages = {
  dashboard: { src: dashboardImg, alt: 'ATW One dashboard home screen with apps launcher and organization overview' },
  crm: { src: crmImg, alt: 'ATW One CRM lead list with company, contact, and pipeline fields' },
  finance: { src: financeImg, alt: 'ATW One finance workspace with invoices, AR metrics, and customer counts' },
} as const;
---

<section class="px-4 pb-10 pt-8">
  <div class="xl-container max-w-4xl text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-blue">{ERP_HERO.badge}</p>
    <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight text-brand-ink sm:text-5xl md:text-6xl">
      {ERP_HERO.headlineLead} {ERP_HERO.headlineAccent}
    </h1>
    <p class="mx-auto mt-6 max-w-3xl text-lg text-dark-text">{ERP_HERO.subhead}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={livePath('/trial')} class="rounded-xl bg-brand-ink px-6 py-3.5 text-sm font-semibold text-white">Start {ERP_TRIAL_LABEL}</a>
      <a href={PRODUCT.one} class="rounded-xl border border-brand-ink/15 bg-white px-6 py-3.5 text-sm font-semibold text-brand-ink">Open One app</a>
      <a href={livePath('/pricing')} class="rounded-xl border border-border px-6 py-3.5 text-sm font-semibold text-brand-ink">Pricing</a>
    </div>
  </div>
  <div class="preview-reveal preview-reveal-delay mx-auto mt-14 max-w-5xl px-4">
    <Picture
      src={dashboardImg}
      alt={showcaseImages.dashboard.alt}
      formats={['avif', 'webp']}
      widths={[800, 1200]}
      sizes="(max-width: 768px) 94vw, 960px"
      width={1200}
      height={616}
      class="w-full rounded-2xl border border-border shadow-2xl shadow-brand-ink/10"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<section class="border-y border-border bg-white/70 px-4 py-20" data-preview-animate>
  <div class="xl-container grid gap-12 lg:grid-cols-3">
    {
      ERP_APP_SHOWCASE_ENTRIES.map((app) => {
        const image = showcaseImages[app.slug as keyof typeof showcaseImages];
        return (
          <a href={livePath(`/erp/apps/${app.slug}`)} class="block">
            <Picture
              src={image.src}
              alt={image.alt}
              formats={['avif', 'webp']}
              widths={[400, 720]}
              sizes="(max-width: 1024px) 92vw, 30vw"
              width={720}
              height={368}
              class="mb-5 w-full rounded-xl border border-border"
              loading="lazy"
            />
            <h2 class="font-heading text-xl font-semibold text-brand-ink">{app.cardTitle}</h2>
            <p class="mt-2 text-sm text-dark-text">{app.cardCaption}</p>
          </a>
        );
      })
    }
  </div>
</section>

<section id="faq" class="scroll-mt-28 px-4 py-20" data-preview-animate>
  <div class="xl-container max-w-3xl">
    <h2 class="text-center font-heading text-3xl font-semibold text-brand-ink">ATW One FAQ</h2>
    <div class="mt-10 space-y-8">
      {
        ONE_FAQS.map((item) => (
          <div class="border-b border-border pb-8">
            <h3 class="font-heading text-lg font-semibold text-brand-ink">{item.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-dark-text">{item.a}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="px-4 pb-20">
  <div class="xl-container rounded-[2rem] bg-brand-ink px-8 py-12 text-center text-white">
    <h2 class="font-heading text-3xl font-semibold">See ATW One in production</h2>
    <p class="mx-auto mt-3 max-w-xl text-white/75">Start a trial or book a walkthrough with our team.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={livePath('/trial')} class="rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-ink">Free trial</a>
      <a href={livePath('/book')} class="rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white">Book a call</a>
    </div>
  </div>
</section>
