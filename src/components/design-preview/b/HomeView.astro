---
import { Picture } from 'astro:assets';
import {
  ERP_APP_SHOWCASE_ENTRIES,
  ERP_CAPABILITIES,
  ERP_CREDITS_SYSTEM_UPDATE,
  ERP_PRIMARY_CTA_LABEL,
  ERP_PRODUCT_WELCOME,
  ERP_TRIAL_LABEL,
} from '../../../data/erpOfferHome';
import { WHY_US } from '../../../data/whyUs';
import { WORKFORCE } from '../../../data/workforce';
import { livePath } from '../../../lib/site';
/** Kyle Photoroom dark logo; display crop removes empty transparent canvas only. */
import brandLogo from '../../../assets/images/branding/atw-one-logo-dark-photoroom-display.png';
import dashboardImg from '../../../assets/images/marketing/atw-one-dashboard-clean.png';
import crmImg from '../../../assets/images/marketing/erp-product-crm.png';
import financeImg from '../../../assets/images/marketing/erp-product-finance.png';
import ErpPricing from '../../marketing/ErpPricing.astro';
import WorkforceSection from './WorkforceSection.astro';

const showcaseImages = {
  dashboard: { src: dashboardImg, alt: 'ATW One dashboard home screen with apps launcher and organization overview' },
  crm: { src: crmImg, alt: 'ATW One CRM lead list with company, contact, and pipeline fields' },
  finance: { src: financeImg, alt: 'ATW One finance workspace with invoices, AR metrics, and customer counts' },
} as const;
---

<section class="relative overflow-hidden pb-14 pt-6 sm:pb-16">
  <div class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-[#5b9bff]/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-16 bottom-0 h-64 w-64 rounded-full bg-[#7ee0ff]/10 blur-3xl" aria-hidden="true"></div>
  <div class="xl-container relative px-4">
    {/*
      Top-align columns (not items-end) so the product shot sits with the brand lockup
      instead of leaving an empty band above the image. Image column is slightly wider
      and uses an aspect box so layout reserves space before paint.
    */}
    <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-stretch lg:gap-10 xl:gap-12">
      <div class="preview-reveal flex max-w-xl flex-col xl:max-w-2xl">
        <div class="mb-6 sm:mb-7">
          <Picture
            src={brandLogo}
            alt="ATW One"
            formats={['avif', 'webp']}
            widths={[240, 360, 480]}
            sizes="(max-width: 640px) 200px, 260px"
            width={480}
            height={223}
            class="h-auto w-[200px] max-w-full bg-transparent object-contain object-left sm:w-[260px]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#7ee0ff]">ATW.Net</p>
        <h1 class="mt-4 font-heading text-4xl font-semibold leading-[1.02] tracking-tight text-white sm:mt-5 sm:text-5xl md:text-6xl lg:text-[3.5rem] xl:text-[4rem]">
          CRM. Finance. Operations. AI.
          <span class="mt-2 block text-[#5b9bff]">One system.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-[#c5d0e0] sm:mt-6 sm:text-lg">
          ATW One keeps customers, sales, finance, and operations in one workspace with hosting plus Credits billing and unlimited named seats.
        </p>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-[#a8b6c9]">
          {WORKFORCE.aspiration}
          <span class="ml-2 inline-flex rounded border border-[#5b9bff]/35 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#7ee0ff]">
            {WORKFORCE.comingOnlineLabel}
          </span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3 sm:mt-9">
          <a href={livePath('/trial')} class="rounded-md bg-[#5b9bff] px-6 py-3.5 text-sm font-semibold text-[#06101c] transition hover:brightness-110">
            Start {ERP_TRIAL_LABEL}
          </a>
          <a href={livePath('/why-us')} class="rounded-md border border-white/30 px-6 py-3.5 text-sm font-semibold text-white hover:bg-white/5">
            Why ATW
          </a>
        </div>
      </div>

      <div class="preview-reveal-media relative flex w-full flex-col">
        <div class="pointer-events-none absolute -inset-3 rounded-3xl bg-gradient-to-br from-[#5b9bff]/28 via-transparent to-[#7ee0ff]/10 blur-2xl sm:-inset-4" aria-hidden="true"></div>
        {/*
          On lg+, stretch the shot to the full copy-column height so there is no empty
          band above or below the media. Mobile keeps intrinsic aspect ratio.
        */}
        <div class="relative min-h-[220px] flex-1 overflow-hidden rounded-2xl border border-white/15 bg-[#0a1526] shadow-2xl shadow-black/50 aspect-[3838/1976] lg:aspect-auto lg:min-h-[28rem]">
          <Picture
            src={dashboardImg}
            alt="ATW One dashboard showing apps, shortcuts, and organization overview"
            formats={['avif', 'webp']}
            widths={[720, 960, 1280, 1600]}
            sizes="(max-width: 1023px) 92vw, (max-width: 1440px) 54vw, 720px"
            width={3838}
            height={1976}
            class="absolute inset-0 h-full w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <p class="relative mt-3 text-sm leading-relaxed text-[#a8b6c9]">
          CRM, Finance, Marketing, HR, and Custom Apps on one Credits pool. Workforce sits beside One ({WORKFORCE.comingOnlineLabel.toLowerCase()}).
        </p>
      </div>
    </div>
  </div>
</section>

<section class="border-y border-white/10 bg-[#0d1a2e]/80 py-20" data-preview-animate>
  <div class="xl-container px-4">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">Consolidation</p>
        <h2 class="mt-4 font-heading text-3xl font-semibold text-white sm:text-4xl">Stop chasing updates across disconnected tools.</h2>
      </div>
      <p class="self-end text-lg leading-relaxed text-[#c5d0e0]">{ERP_PRODUCT_WELCOME.paragraph}</p>
    </div>
    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {
        ERP_APP_SHOWCASE_ENTRIES.map((entry) => {
          const image = showcaseImages[entry.slug as keyof typeof showcaseImages];
          return (
            <a href={livePath(`/erp/apps/${entry.slug}`)} class="group relative overflow-hidden rounded-2xl border border-white/15 bg-[#0f1c30]">
              <Picture
                src={image.src}
                alt={image.alt}
                formats={['avif', 'webp']}
                widths={[480, 720]}
                sizes="(max-width: 768px) 92vw, 30vw"
                width={720}
                height={368}
                class="h-44 w-full object-cover object-top opacity-95 transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="p-5">
                <h3 class="font-heading text-xl font-semibold text-white">{entry.cardTitle}</h3>
                <p class="mt-2 text-sm text-[#c5d0e0]">{entry.cardCaption}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<WorkforceSection />

<section class="py-20" data-preview-animate>
  <div class="xl-container px-4">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">{WHY_US.eyebrow}</p>
        <h2 class="mt-4 font-heading text-3xl font-semibold leading-tight text-white sm:text-5xl">{WHY_US.title}</h2>
        <p class="mt-6 text-[#c5d0e0]">{WHY_US.paragraph}</p>
        <a href={livePath('/why-us')} class="mt-8 inline-flex text-sm font-semibold text-[#7ee0ff] hover:underline">{WHY_US.learnMoreLabel}</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {
          WHY_US.pillars.map((pillar) => (
            <div class="rounded-2xl border border-white/15 bg-[#0f1c30] p-6">
              <h3 class="font-heading text-lg font-semibold text-white">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[#c5d0e0]">{pillar.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="border-y border-white/10 py-20" data-preview-animate>
  <div class="xl-container px-4">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">{ERP_CREDITS_SYSTEM_UPDATE.eyebrow}</p>
    <h2 class="mt-4 max-w-3xl font-heading text-3xl font-semibold text-white sm:text-4xl">{ERP_CREDITS_SYSTEM_UPDATE.title}</h2>
    <p class="mt-5 max-w-3xl text-[#c5d0e0]">{ERP_CREDITS_SYSTEM_UPDATE.paragraph}</p>
    <div class="mt-8 grid gap-3 md:grid-cols-2">
      {
        ERP_CREDITS_SYSTEM_UPDATE.bullets.map((b) => (
          <div class="rounded-xl border border-[#5b9bff]/30 bg-[#5b9bff]/10 px-5 py-4 text-sm text-[#c5d0e0]">{b}</div>
        ))
      }
    </div>
  </div>
</section>

<section class="py-20" data-preview-animate>
  <div class="xl-container px-4">
    <h2 class="font-heading text-3xl font-semibold text-white">Capabilities</h2>
    <div class="mt-10 columns-1 gap-8 sm:columns-2 lg:columns-3">
      {
        ERP_CAPABILITIES.map((block) => (
          <div class="mb-8 break-inside-avoid border-t border-white/15 pt-4">
            <h3 class="font-heading text-lg font-semibold text-[#7ee0ff]">{block.title}</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-[#c5d0e0]">
              {block.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="pb-6" data-preview-animate>
  <div class="preview-b-pricing">
    <ErpPricing />
  </div>
</section>

<section class="px-4 pb-20">
  <div class="xl-container relative overflow-hidden rounded-3xl border border-[#5b9bff]/35 bg-gradient-to-r from-[#0b1729] via-[#10233f] to-[#0b1729] px-8 py-14 text-center">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(91,155,255,0.18),transparent_60%)]" aria-hidden="true"></div>
    <div class="relative">
      <h2 class="font-heading text-3xl font-semibold text-white sm:text-4xl">Build with the team behind the platform</h2>
      <p class="mx-auto mt-4 max-w-2xl text-[#c5d0e0]">{WHY_US.closing}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={livePath('/book')} class="rounded-md bg-white px-7 py-3.5 text-sm font-semibold text-[#06101c]">{ERP_PRIMARY_CTA_LABEL}</a>
        <a href={livePath('/trial')} class="rounded-md border border-white/30 px-7 py-3.5 text-sm font-semibold text-white">Start {ERP_TRIAL_LABEL}</a>
      </div>
    </div>
  </div>
</section>
