---
import { Picture } from 'astro:assets';
import {
  ERP_APP_SHOWCASE_ENTRIES,
  ERP_CREDITS_SYSTEM_UPDATE,
  ERP_PRIMARY_CTA_LABEL,
  ERP_PRODUCT_WELCOME,
  ERP_TRIAL_LABEL,
} from '../../../data/erpOfferHome';
import { B_PRODUCT_CARDS } from '../../../data/designPreviewB';
import { ORBIT, ORBIT_APPS_COMING_SOON, ORBIT_APPS_LIVE, ORBIT_ONE_LINER } from '../../../data/orbit';
import { WHY_US } from '../../../data/whyUs';
import { WORKFORCE } from '../../../data/workforce';
import { livePath } from '../../../lib/site';
/** Kyle Photoroom dark logo; display crop removes empty transparent canvas only. */
import brandLogo from '../../../assets/images/branding/atw-one-logo-dark-photoroom-display.png';
import dashboardImg from '../../../assets/images/marketing/atw-one-dashboard-clean.png';
import crmImg from '../../../assets/images/marketing/erp-product-crm.png';
import financeImg from '../../../assets/images/marketing/erp-product-finance.png';
import ErpPricing from '../../marketing/ErpPricing.astro';
import WorkforceSection from './WorkforceSection.astro';
import WhatsIncludedSection from './WhatsIncludedSection.astro';

const showcaseImages = {
  dashboard: { src: dashboardImg, alt: 'ATW One dashboard home screen with apps launcher and organization overview' },
  crm: { src: crmImg, alt: 'ATW One CRM lead list with company, contact, and pipeline fields' },
  finance: { src: financeImg, alt: 'ATW One finance workspace with invoices, AR metrics, and customer counts' },
} as const;
---

<section class="relative overflow-hidden pb-12 pt-6 sm:pb-14 lg:pb-16">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_15%_0%,rgba(91,155,255,0.22),transparent_52%),radial-gradient(ellipse_at_85%_10%,rgba(126,224,255,0.12),transparent_48%)]" aria-hidden="true"></div>

  {/*
    First track = site left gutter + copy width so text lines up with the
    xl-container. Media track runs to the viewport edge; the shot is sized in
    rem and object-left so zoom crops the right instead of shrinking to fit.
  */}
  <div class="relative lg:grid lg:grid-cols-[minmax(0,calc((100vw-72rem)/2+30rem))_minmax(0,1fr)] lg:items-center">
    <div class="relative z-10 px-4 lg:pl-[max(1rem,calc((100vw-72rem)/2+1rem))] lg:pr-8">
      <div class="preview-reveal max-w-xl pb-8 lg:max-w-[28rem] lg:pb-2 xl:max-w-[30rem]">
        <div class="mb-6 sm:mb-7">
          <Picture
            src={brandLogo}
            alt="ATW One"
            formats={['avif', 'webp']}
            widths={[240, 360, 480]}
            sizes="(max-width: 640px) 200px, 260px"
            width={480}
            height={223}
            class="h-auto w-[200px] max-w-full bg-transparent object-contain object-left sm:w-[260px]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#7ee0ff]">ATW.Net</p>
        <h1 class="mt-4 font-heading text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:mt-5 sm:text-5xl md:text-6xl lg:text-[2.85rem] xl:text-[3.35rem]">
          One system for the work that runs your business.
        </h1>
        <p class="mt-5 text-base leading-relaxed text-[#c5d0e0] sm:mt-6 sm:text-lg">
          ATW One brings CRM, finance, and operations together with Credits billing and unlimited named seats. Orbit, Hub, Directory, and AI sit beside it under one organization.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-[#a8b6c9]">
          {WORKFORCE.aspiration}
          <span class="ml-2 inline-flex rounded border border-[#5b9bff]/35 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#7ee0ff]">
            {WORKFORCE.comingOnlineLabel}
          </span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3 sm:mt-9">
          <a href={livePath('/trial')} class="rounded-md bg-[#5b9bff] px-6 py-3.5 text-sm font-semibold text-[#06101c] transition hover:brightness-110">
            Start {ERP_TRIAL_LABEL}
          </a>
          <a href={livePath('/why-us')} class="rounded-md border border-white/30 px-6 py-3.5 text-sm font-semibold text-white hover:bg-white/5">
            Why ATW
          </a>
        </div>
      </div>
    </div>

    <div class="preview-reveal-media relative min-w-0 w-full">
      <div class="pointer-events-none absolute -inset-y-6 left-0 right-0 bg-gradient-to-l from-[#5b9bff]/16 via-transparent to-transparent blur-2xl" aria-hidden="true"></div>
      <figure class="relative m-0 px-4 lg:px-0">
        <div class="overflow-hidden rounded-2xl border border-white/15 bg-[#0a1526] shadow-2xl shadow-black/45 lg:h-[22rem] lg:rounded-l-2xl lg:rounded-r-none lg:border-r-0 xl:h-[25rem]">
          <Picture
            src={dashboardImg}
            alt="ATW One dashboard showing apps, shortcuts, and organization overview"
            formats={['avif', 'webp']}
            widths={[720, 960, 1280, 1600]}
            sizes="(max-width: 1023px) 92vw, 60vw"
            width={3838}
            height={1976}
            class="block h-auto w-full max-w-none lg:h-full lg:w-[max(100%,48rem)] lg:max-w-none lg:object-cover lg:object-left-top"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="relative mt-3 text-sm leading-relaxed text-[#a8b6c9] lg:pl-1">
          CRM, Finance, Marketing, HR, and Custom Apps on one Credits pool.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="border-y border-white/10 py-16 sm:py-20" data-preview-animate>
  <div class="xl-container px-4">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">ATW systems</p>
    <h2 class="mt-3 max-w-2xl font-heading text-3xl font-semibold tracking-tight text-white sm:text-4xl">
      The platform around ATW One
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#c5d0e0]">
      Clear products. Shared identity. One Credits pool. No invented add-ons.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        B_PRODUCT_CARDS.map((card) => (
          <li>
            <a
              href={card.href}
              class="group flex h-full flex-col border border-white/10 bg-[#0d1a2e]/55 px-5 py-6 transition hover:border-[#5b9bff]/45 hover:bg-[#122036]/80"
            >
              <div class="min-h-[2.75rem]">
                {card.id === 'one' ? (
                  <Picture
                    src={brandLogo}
                    alt="ATW One logo"
                    formats={['avif', 'webp']}
                    widths={[160, 240]}
                    sizes="160px"
                    width={240}
                    height={112}
                    class="h-8 w-auto max-w-[160px] object-contain object-left"
                    loading="lazy"
                    decoding="async"
                  />
                ) : card.wordmark ? (
                  <picture>
                    {card.wordmark.src.endsWith('.webp') ? (
                      <source srcset={card.wordmark.src} type="image/webp" />
                    ) : null}
                    <img
                      src={card.wordmark.png || card.wordmark.src}
                      alt={card.wordmark.alt}
                      width={card.wordmark.width}
                      height={card.wordmark.height}
                      class="h-8 w-auto max-w-[180px] object-contain object-left"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                ) : card.markWithLabel ? (
                  <span class="flex items-center gap-2">
                    <picture>
                      {card.markWithLabel.src.endsWith('.webp') ? (
                        <source srcset={card.markWithLabel.src} type="image/webp" />
                      ) : null}
                      <img
                        src={card.markWithLabel.png || card.markWithLabel.src}
                        alt={card.markWithLabel.alt}
                        width={card.markWithLabel.width}
                        height={card.markWithLabel.height}
                        class="h-8 w-auto max-w-[2.5rem] object-contain object-left"
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                    <span class="font-heading text-lg font-semibold text-white">{card.markWithLabel.label}</span>
                  </span>
                ) : card.icon ? (
                  <span class="flex items-center gap-2">
                    <img
                      src={card.icon}
                      alt=""
                      width={24}
                      height={24}
                      class="h-6 w-6 object-contain"
                      aria-hidden="true"
                    />
                    <span class="font-heading text-lg font-semibold text-white">{card.title}</span>
                  </span>
                ) : (
                  <span class="font-heading text-lg font-semibold text-white">{card.title}</span>
                )}
              </div>
              <span class="mt-4 flex flex-wrap items-center gap-2">
                {card.wordmark || card.id === 'one' || card.markWithLabel ? (
                  <span class="sr-only">{card.title}</span>
                ) : null}
                {card.status === 'coming-online' ? (
                  <span class="rounded border border-[#5b9bff]/35 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#7ee0ff]">
                    Coming online
                  </span>
                ) : null}
              </span>
              <p class="mt-3 text-sm leading-relaxed text-[#a8b6c9]">{card.summary}</p>
              <span class="mt-auto pt-5 text-xs font-semibold uppercase tracking-[0.14em] text-[#7ee0ff] group-hover:underline">
                Explore
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="relative overflow-hidden border-b border-white/10 py-16 sm:py-20" data-preview-animate>
  <div class="pointer-events-none absolute -right-10 top-10 h-64 w-64 rounded-full bg-[#5b9bff]/10 blur-3xl" aria-hidden="true"></div>
  <div class="xl-container relative px-4">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">ATW Orbit</p>
        <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Each app is a planet in your Orbit
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-[#c5d0e0]">{ORBIT_ONE_LINER}</p>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[#a8b6c9]">{ORBIT.inclusionNote}</p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#c5d0e0]">
          <span>
            <span class="font-semibold text-white">Live:</span>
            {ORBIT_APPS_LIVE.map((a) => a.title).join(', ')}
          </span>
          <span>
            <span class="font-semibold text-white">Soon:</span>
            {ORBIT_APPS_COMING_SOON.map((a) => a.title).join(', ')}
          </span>
        </div>
        <a href="/orbit/" class="mt-8 inline-flex rounded-md bg-[#5b9bff] px-5 py-3 text-sm font-semibold text-[#06101c]">
          Explore ATW Orbit
        </a>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          [...ORBIT_APPS_LIVE, ...ORBIT_APPS_COMING_SOON].map((app) => (
            <div class="border border-white/10 bg-[#0d1a2e]/70 px-4 py-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-heading text-sm font-semibold text-white">{app.title}</span>
                {app.status === 'coming-soon' ? (
                  <span class="text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-[#7ee0ff]">Soon</span>
                ) : null}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="border-b border-white/10 bg-[#0d1a2e]/70 py-20 sm:py-24" data-preview-animate>
  <div class="xl-container px-4">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">Consolidation</p>
        <h2 class="mt-4 font-heading text-3xl font-semibold tracking-tight text-white sm:text-4xl">Stop chasing updates across disconnected tools.</h2>
      </div>
      <p class="text-base leading-relaxed text-[#c5d0e0] sm:text-lg">{ERP_PRODUCT_WELCOME.paragraph}</p>
    </div>
    <div class="mt-14 grid gap-8 border-t border-white/10 pt-10 md:grid-cols-3 md:gap-10">
      {
        ERP_APP_SHOWCASE_ENTRIES.map((entry) => {
          const image = showcaseImages[entry.slug as keyof typeof showcaseImages];
          return (
            <a href={livePath(`/erp/apps/${entry.slug}`)} class="group block">
              <div class="overflow-hidden rounded-xl border border-white/12 bg-[#0a1526]">
                <Picture
                  src={image.src}
                  alt={image.alt}
                  formats={['avif', 'webp']}
                  widths={[480, 720]}
                  sizes="(max-width: 768px) 92vw, 30vw"
                  width={1024}
                  height={523}
                  class="h-auto w-full max-w-full opacity-95 transition duration-500 group-hover:opacity-100"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3 class="mt-4 font-heading text-xl font-semibold text-white">{entry.cardTitle}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#a8b6c9]">{entry.cardCaption}</p>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<WhatsIncludedSection />

<WorkforceSection />

<section class="py-20 sm:py-24" data-preview-animate>
  <div class="xl-container px-4">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">{WHY_US.eyebrow}</p>
        <h2 class="mt-4 font-heading text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">{WHY_US.title}</h2>
        <p class="mt-6 text-base leading-relaxed text-[#c5d0e0]">{WHY_US.paragraph}</p>
        <a href={livePath('/why-us')} class="mt-8 inline-flex text-sm font-semibold text-[#7ee0ff] hover:underline">{WHY_US.learnMoreLabel}</a>
      </div>
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-7">
        {
          WHY_US.pillars.map((pillar) => (
            <div class="border-t border-white/15 pt-5">
              <h3 class="font-heading text-lg font-semibold text-white">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[#a8b6c9]">{pillar.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="border-y border-white/10 py-20" data-preview-animate>
  <div class="xl-container px-4">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#7ee0ff]">{ERP_CREDITS_SYSTEM_UPDATE.eyebrow}</p>
    <h2 class="mt-4 max-w-3xl font-heading text-3xl font-semibold text-white sm:text-4xl">{ERP_CREDITS_SYSTEM_UPDATE.title}</h2>
    <p class="mt-5 max-w-3xl text-[#c5d0e0]">{ERP_CREDITS_SYSTEM_UPDATE.paragraph}</p>
    <div class="mt-8 grid gap-3 md:grid-cols-2">
      {
        ERP_CREDITS_SYSTEM_UPDATE.bullets.map((b) => (
          <div class="rounded-xl border border-[#5b9bff]/30 bg-[#5b9bff]/10 px-5 py-4 text-sm text-[#c5d0e0]">{b}</div>
        ))
      }
    </div>
  </div>
</section>

<section class="pb-6" data-preview-animate>
  <div class="preview-b-pricing">
    <ErpPricing />
  </div>
</section>

<section class="px-4 pb-20 sm:pb-24">
  <div class="xl-container border border-white/12 bg-[#0d1a2e]/80 px-8 py-14 text-center sm:px-12 sm:py-16">
    <h2 class="font-heading text-3xl font-semibold tracking-tight text-white sm:text-4xl">Build with the team behind the platform</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-[#c5d0e0]">{WHY_US.closing}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={livePath('/book')} class="rounded-md bg-[#5b9bff] px-7 py-3.5 text-sm font-semibold text-[#06101c]">{ERP_PRIMARY_CTA_LABEL}</a>
      <a href={livePath('/trial')} class="rounded-md border border-white/25 px-7 py-3.5 text-sm font-semibold text-white">Start {ERP_TRIAL_LABEL}</a>
    </div>
  </div>
</section>
