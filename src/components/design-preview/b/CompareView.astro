---
import { COMPARE_INDEX, COMPARE_PAGES } from '../../../data/comparePages';
import { livePath } from '../../../lib/site';
---

<section class="relative overflow-hidden px-4 py-14 sm:py-16">
  <div class="pointer-events-none absolute -left-10 top-10 h-52 w-52 rounded-full bg-[#4d8fff]/20 blur-3xl" aria-hidden="true"></div>
  <div class="xl-container relative max-w-4xl">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#6ee7ff]">Compare</p>
    <h1 class="mt-5 font-heading text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl md:text-6xl">
      ATW compared with Zoho One, Odoo, Google Workspace, HubSpot, Salesforce, and QuickBooks
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-white/70">{COMPARE_INDEX.intro}</p>
  </div>
</section>

<section class="border-y border-white/10 bg-[#0b1729]/75 px-4 py-16" data-preview-animate>
  <div class="xl-container">
    <h2 class="font-heading text-2xl font-semibold text-white">Comparison guides</h2>
    <p class="mt-2 max-w-2xl text-white/60">
      Each page opens with a direct answer, then a table, fair "when to choose" notes, FAQ, and a contact CTA.
    </p>
    <ul class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        COMPARE_PAGES.map((page) => (
          <li>
            <a
              href={`/compare/${page.slug}/`}
              class="flex h-full flex-col rounded-2xl border border-white/10 bg-gradient-to-br from-white/[0.05] to-transparent p-6 transition hover:border-[#4d8fff]/50"
            >
              <h3 class="font-heading text-lg font-semibold text-white">{page.h1}</h3>
              <p class="mt-3 flex-1 text-sm text-white/60">{page.description}</p>
              <p class="mt-5 text-sm font-semibold text-[#6ee7ff]">Read comparison</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="px-4 py-20">
  <div class="xl-container rounded-3xl border border-[#4d8fff]/30 px-8 py-12 text-center">
    <h2 class="font-heading text-3xl font-semibold text-white">Still deciding between stacks?</h2>
    <p class="mx-auto mt-3 max-w-2xl text-white/65">
      Tell us what you run today. We will recommend ATW One, ATW Mail, or staying on your current vendor when that is smarter.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={livePath('/contact')} class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-[#07111f]">Contact us</a>
      <a href={livePath('/book')} class="rounded-md border border-white/25 px-6 py-3 text-sm font-semibold text-white">Book a call</a>
    </div>
  </div>
</section>
