---
import { WHY_US } from '../../../data/whyUs';
import { ERP_PRIMARY_CTA_LABEL, ERP_TRIAL_LABEL } from '../../../data/erpOfferHome';
import { livePath } from '../../../lib/site';
---

<section class="relative overflow-hidden px-4 pb-16 pt-10">
  <div class="pointer-events-none absolute right-0 top-0 h-64 w-64 rounded-full bg-[#4d8fff]/20 blur-3xl" aria-hidden="true"></div>
  <div class="xl-container relative max-w-5xl">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#6ee7ff]">{WHY_US.eyebrow}</p>
    <h1 class="mt-5 max-w-4xl font-heading text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl">
      {WHY_US.title}
    </h1>
    <p class="mt-7 max-w-3xl text-lg leading-relaxed text-white/70">{WHY_US.paragraph}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={livePath('/book')} class="rounded-md bg-[#4d8fff] px-6 py-3.5 text-sm font-semibold text-[#07111f]">{ERP_PRIMARY_CTA_LABEL}</a>
      <a href={livePath('/trial')} class="rounded-md border border-white/20 px-6 py-3.5 text-sm font-semibold text-white">Start {ERP_TRIAL_LABEL}</a>
    </div>
  </div>
</section>

<section class="border-y border-white/10 bg-[#0b1729]/80 px-4 py-20" data-preview-animate>
  <div class="xl-container grid gap-5 md:grid-cols-2">
    {
      WHY_US.pillars.map((pillar, i) => (
        <div class="rounded-2xl border border-white/10 p-7">
          <p class="text-xs font-semibold tracking-[0.2em] text-[#4d8fff]">0{i + 1}</p>
          <h2 class="mt-3 font-heading text-2xl font-semibold text-white">{pillar.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/65">{pillar.description}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="px-4 py-20" data-preview-animate>
  <div class="xl-container">
    <h2 class="font-heading text-3xl font-semibold text-white sm:text-4xl">{WHY_US.comparisonTitle}</h2>
    <div class="mt-10 space-y-4">
      {
        WHY_US.comparisonRows.map((row) => (
          <div class="grid gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 lg:grid-cols-[0.8fr_1fr_1fr]">
            <div>
              <p class="text-xs uppercase tracking-[0.16em] text-[#6ee7ff]">Factor</p>
              <p class="mt-2 font-heading text-lg font-semibold text-white">{row.factor}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.16em] text-[#a8b6c9]">Typical vendors</p>
              <p class="mt-2 text-sm text-white/60">{row.typical}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.16em] text-[#4d8fff]">ATW</p>
              <p class="mt-2 text-sm text-white/90">{row.atw}</p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="mx-auto mt-12 max-w-3xl text-center text-xl font-medium leading-relaxed text-white/85">{WHY_US.closing}</p>
  </div>
</section>

<section class="px-4 pb-20">
  <div class="xl-container rounded-3xl border border-[#4d8fff]/30 bg-gradient-to-br from-[#10233f] to-[#0b1729] px-8 py-12 text-center">
    <h2 class="font-heading text-3xl font-semibold text-white">Work directly with ATW</h2>
    <p class="mx-auto mt-3 max-w-xl text-white/65">Book a review or start a trial on ATW One.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={livePath('/book')} class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-[#07111f]">Book a call</a>
      <a href={livePath('/contact')} class="rounded-md border border-white/25 px-6 py-3 text-sm font-semibold text-white">Contact</a>
    </div>
  </div>
</section>
