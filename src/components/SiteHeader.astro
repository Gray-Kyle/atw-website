---
import { Picture } from 'astro:assets';
import { AUTH_SIGNIN, livePath } from '../lib/site';
import { marketingPartnerLinks, marketingServiceLinks } from '../lib/marketingNav';
import SystemsMegaMenu from './nav/SystemsMegaMenu.astro';
import MarketingDropdown from './nav/MarketingDropdown.astro';
import SystemsMobileSection from './nav/SystemsMobileSection.astro';
import siteLogo from '../assets/images/logo/logo.png';

const currentPath = Astro.url.pathname;

const navLinkClass = (active: boolean) =>
  [
    'text-sm font-medium transition-colors hover:text-primary',
    active ? 'text-brand-ink' : 'text-muted-foreground',
  ].join(' ');
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full bg-white/95 py-4 shadow-sm backdrop-blur-sm transition-all"
>
  <div class="xl-container flex items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="ATW.Net home">
      <Picture
        src={siteLogo}
        alt="ATW.Net"
        formats={['avif', 'webp']}
        widths={[120, 240]}
        sizes="120px"
        width={120}
        height={120}
        class="h-[52px] w-auto max-w-[140px] object-contain object-left sm:h-[60px]"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      <SystemsMegaMenu />
      <MarketingDropdown label="Services" links={marketingServiceLinks} />
      <MarketingDropdown label="Partners" links={marketingPartnerLinks} />
      <a href="/pricing" class={navLinkClass(currentPath === '/pricing')}>Pricing</a>
      <a href={livePath('/why-us')} class={navLinkClass(currentPath === '/why-us')}>Why Us</a>
      <a
        href={livePath('/book')}
        class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white shadow-md hover:brightness-110"
      >
        Book a Call
      </a>
      <a
        href={AUTH_SIGNIN}
        class="rounded-full border border-brand-navy/30 px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-navy/5"
      >
        Sign In
      </a>
    </nav>

    <button
      type="button"
      id="mobile-nav-toggle"
      class="inline-flex items-center rounded border border-border px-3 py-2 text-sm font-medium lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      Menu
    </button>
  </div>

  <div
    id="mobile-nav-panel"
    class="invisible max-h-0 overflow-hidden border-b border-border bg-white/95 opacity-0 backdrop-blur-sm transition-all duration-300 lg:hidden"
    aria-hidden="true"
  >
    <div class="xl-container flex flex-col gap-4 py-4">
      <details class="group/mobile-systems">
        <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden">
          Systems
          <svg
            class="h-4 w-4 transition group-open/mobile-systems:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <SystemsMobileSection />
      </details>

      {
        [
          { title: 'Services', href: '/services', links: marketingServiceLinks },
          { title: 'Partners', href: '/partners', links: marketingPartnerLinks },
        ].map((section) => (
          <details class="group/mobile-section">
            <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden">
              {section.title}
              <svg
                class="h-4 w-4 transition group-open/mobile-section:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="space-y-1 pl-3">
              {section.links.map((link) => (
                <a href={link.href} class="block py-1.5 text-sm text-muted-foreground hover:text-brand-ink">
                  {link.title}
                </a>
              ))}
            </div>
          </details>
        ))
      }

      <a href="/pricing" class="py-2 text-sm font-medium text-brand-ink">Pricing</a>
      <a href={livePath('/why-us')} class="py-2 text-sm font-medium text-brand-ink">Why Us</a>
      <a href={livePath('/book')} class="py-2 text-sm font-semibold text-primary">Book a Call</a>
      <a href={AUTH_SIGNIN} class="py-2 text-sm font-medium text-brand-ink">Sign In</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');

  function setMobileOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (open) {
      panel.classList.remove('invisible', 'max-h-0', 'opacity-0');
      panel.classList.add('visible', 'max-h-[calc(100vh-5rem)]', 'opacity-100', 'overflow-y-auto');
      document.body.style.overflow = 'hidden';
    } else {
      panel.classList.add('invisible', 'max-h-0', 'opacity-0');
      panel.classList.remove('visible', 'max-h-[calc(100vh-5rem)]', 'opacity-100', 'overflow-y-auto');
      document.body.style.overflow = '';
    }
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMobileOpen(open);
  });

  document.addEventListener('astro:page-load', () => setMobileOpen(false));

  const bindScrollShadow = () => {
    if (!header) return;
    const onScroll = () => {
      header.classList.toggle('shadow-md', window.scrollY > 10);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(bindScrollShadow, { timeout: 2000 });
  } else {
    setTimeout(bindScrollShadow, 1);
  }
</script>
