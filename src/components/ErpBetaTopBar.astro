---
/**
 * Sitewide announcement: ATW ERP coming soon, beta available, learn-more contact form.
 * Shown on production Option B chrome (and sandboxes). Submissions use /api/contact.
 */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<div
  id="erp-beta-top-bar"
  class="erp-beta-top-bar relative z-[61] border-b border-[#5b9bff]/35 bg-[#0a1628] text-[#f2f6fc]"
  data-erp-beta-bar
>
  <div class="xl-container flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-2.5">
    <p class="min-w-0 flex-1 text-sm leading-snug sm:text-[0.9375rem]">
      <span class="font-semibold text-white">ATW ERP is coming soon.</span>
      {' '}
      <span class="text-[#c5d0e0]">Beta access is available now.</span>
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="inline-flex h-8 items-center justify-center rounded-md bg-[#5b9bff] px-3 text-xs font-semibold text-[#06101c] transition hover:bg-[#7ee0ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7ee0ff]"
        data-erp-beta-open
        aria-expanded="false"
        aria-controls="erp-beta-panel"
      >
        Learn more
      </button>
      <button
        type="button"
        class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[#a8b6c9] transition hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7ee0ff]"
        data-erp-beta-dismiss
        aria-label="Dismiss announcement"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
          ><path
            d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"
          ></path></svg
        >
      </button>
    </div>
  </div>

  <div
    id="erp-beta-panel"
    class="hidden border-t border-white/10 bg-[#07111f]"
    data-erp-beta-panel
    hidden
  >
    <div class="xl-container py-5 sm:py-6">
      <div class="mx-auto max-w-xl">
        <h2 class="font-heading text-lg font-semibold text-white sm:text-xl">
          Get ATW ERP beta updates
        </h2>
        <p class="mt-1.5 text-sm text-[#c5d0e0]">
          Tell us how to reach you. We will share beta timing and next steps.
        </p>
        <div
          id="erp-beta-form-root"
          class="mt-4"
          data-turnstile-site-key={turnstileSiteKey}
        >
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    try {
      if (localStorage.getItem('atw-erp-beta-bar-dismissed') === '1') {
        document.documentElement.dataset.hideErpBetaBar = '1';
      }
    } catch (_) {}
  })();
</script>

<style is:global>
  html[data-hide-erp-beta-bar] #erp-beta-top-bar {
    display: none !important;
  }
</style>

<script src="/js/erp-beta-interest.js" defer></script>
